            bot = 1
        account = bool(e.get('DOLL_ACCOUNT_ID'))
        on = e.get('DOLL_ENABLED', '1') == '1'       # (set to play; enabled: and may, an accountless one with DOLL_GATE=0 not)
        out.append({'n': n, 'bot': bot, 'account': account, 'name': '' if account else doll_name(n, e),
                    'name_set': '' if account else e.get('DOLL_NAME', ''), 'on': on,
                    'enabled': on and (account or accountless), 'follow': e.get('DOLL_DIFFICULTY') == 'vdoll'})
    return out


# (v150-host beta 16) a doll's difficulty following its bot's virtual dolls' level (DOLL_DIFFICULTY=vdoll)
VDOLL_LEVEL_RE = re.compile(r'^([1-9]|10)(,([1-9]|10)){0,14}$')


def vdoll_levels(bot):
    """A bot's virtual dolls' levels as its game takes them (mgo1host.sh): its VDOLL_LEVEL, 1 to 10 or one a doll (the last
    for the rest), else the game's own 5."""
    v = re.sub(r'\s', '', env_file(f'{ETC}/bot{bot}.env').get('VDOLL_LEVEL', ''))
    return v if VDOLL_LEVEL_RE.match(v) else '5'


def follow_levels(ds):
    """The levels of the dolls that follow their bot's virtual dolls, for /var/lib/mgo1host/dolls.levels (mgo1doll.sh reads
    it: a doll's own user reads neither its bot's settings nor the other dolls'): a line a doll, `<doll> <level> <bot>
    <the bot's VDOLL_LEVEL>`. The k-th of a bot's dolls set to play (DOLL_ENABLED=1), in their numbers' order, takes the k-th
    level of the list, the last for the rest (as the bot's virtual dolls do)."""
    out, lists = '', {}
    for d in ds:
        if d['follow']:
            lv = lists.setdefault(d['bot'], vdoll_levels(d['bot'])).split(',')
            k = len([x for x in ds if x['bot'] == d['bot'] and x['on'] and x['n'] < d['n']])
            out += '%d %s %d %s\n' % (d['n'], lv[min(k, len(lv) - 1)], d['bot'], lists[d['bot']])
    return out


# ---- a bot's DOLL_COUNT: its accountless dolls added or removed (under a lock: mgo1host-agent runs it too) ----
def write_private(path, text):
    tmp = path + '.tmp'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(text)
    os.replace(tmp, path)


def doll_counts(accountless, unit_states=None):
    """True when a doll was added or removed."""
    if not accountless:
        return False
    try:
        lock = open(f'{ETC}/.dolls.lock', 'a')
        fcntl.flock(lock, fcntl.LOCK_EX)
    except OSError:
        return False
    changed = False
    # (v141 beta 5) mgo1host-agent doll-count's name for the doll it adds (MGO1 Host.exe: the next doll's name)
    new_name, new_bot = os.environ.get('MGO1_DOLL_NEW_NAME', ''), os.environ.get('MGO1_DOLL_NEW_BOT', '')
    if not (DOLL_NAME_RE.match(new_name) and '  ' not in new_name):
        new_name = ''
    try:
        ds = dolls(accountless)
        busy = None                                # the numbers whose service still runs (asked once, when needed)
        for b in range(1, MAX_BOTS + 1):
            if not os.path.exists(f'{ETC}/bot{b}.env'):
                continue
            benv = env_file(f'{ETC}/bot{b}.env')
            v = benv.get('DOLL_COUNT', '')
            if not v.isdigit():
                continue
            # (v150-host beta 16) a new doll of a bot that has virtual dolls set (VDOLL_COUNT above 0, or a VDOLL_LEVEL) plays at
            # their level (DOLL_DIFFICULTY=vdoll: mgo1doll.sh), else at 3 as before
            vc = benv.get('VDOLL_COUNT', '')
            level = 'vdoll' if (vc.isdigit() and int(vc) > 0) or 'VDOLL_LEVEL' in benv else '3'
            # (v141) no more than its game takes: its max_players less the host, less its dolls with an account
            acc = len([d for d in ds if d['bot'] == b and d['account']])
            want = min(int(v), MAX_DOLLS, max(0, game_max_players(b) - 1 - acc))
            mine = sorted(d['n'] for d in ds if d['bot'] == b and not d['account'])
            while len(mine) > want:
                n = mine.pop()
                systemctl('stop', f'mgo1doll@{n}')
                try:
                    os.remove(f'{ETC}/doll{n}.env')
                except OSError:
                    pass
                shutil.rmtree(f'{VAR}/doll{n}', ignore_errors=True)
                ds = [d for d in ds if d['n'] != n]
                changed = True
                say('doll %d: removed (bot %d has DOLL_COUNT=%d)' % (n, b, want))
            while len(mine) < want:
                if busy is None:
                    st = unit_states or states([f'mgo1doll@{k}' for k in range(1, MAX_DOLLS + 1)])
                    busy = {k for k in range(1, MAX_DOLLS + 1) if st.get(f'mgo1doll@{k}', 'inactive') in RUNNING}
                taken = {d['n'] for d in ds} | busy
                free = [k for k in range(1, MAX_DOLLS + 1) if k not in taken]
                if not free:
                    say('bot %d: DOLL_COUNT=%d, but the %d dolls of the server are taken' % (b, want, MAX_DOLLS), 'W')
                    break
                n = free[0]
                name = new_name if new_name and new_bot == str(b) else ''
                new_name = '' if name else new_name
                try:
                    write_private(f'{ETC}/doll{n}.env', '# PLAYABLE DOLL %d: accountless (DOLL_%d), for bot %d (DOLL_COUNT)\n'
                                  '%sDOLL_BOT=%d\nDOLL_DIFFICULTY=%s\nDOLL_ADAPT=1\nDOLL_TEAM=auto\nDOLL_ENABLED=1\n'
                                  % (n, n, b, 'DOLL_NAME=%s\n' % name if name else '', b, level))
                    write_failed(f'{ETC}/doll<N>.env')
                except OSError as e:                       # (tried again at the next round)
                    write_failed(f'{ETC}/doll<N>.env', e, 'bot %d\'s DOLL_COUNT=%d not reached, no doll added' % (b, want))
                    break
                doll_dir(n)
                ds.append({'n': n, 'bot': b, 'account': False, 'name': name or 'DOLL_%d' % n, 'enabled': True})
                mine.append(n)
                changed = True
                say('doll %d: added for bot %d as %s (bot %d has DOLL_COUNT=%d)' % (n, b, name or 'DOLL_%d' % n, b, want))
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()
    return changed


def say_why(bot, sums, said):
    """(v150-host beta 16) Why a bot's playable dolls do not all start (doll_sums): a line in the manager's daily log and the
    bot's each time the reason changes, and once each day while it lasts (every day's log tells it)."""
    key = (sums['sig'], time.strftime('%Y-%m-%d', time.gmtime())) if sums['sig'] else None
    if key and said.get(bot) != key:
        say(sums['why'], sums['level'], f'bot{bot}')
    said[bot] = key


def main():
    global FAST_S
    last_start = -1e9
    rounds = 0
    leaving = {}                     # doll -> time its leave order was given
    names_written = None
    levels_written = None            # (v150-host beta 16) dolls.levels: the dolls that follow their bot's virtual dolls' level
    said_budget = None
    said_same = None
    active_since = {}                # unit -> when the manager first saw it running (the watchdog)
    pending_since = {}               # doll -> when it was first seen running and not in its bot's game
    pending_frame = {}               # (v141 beta 9) doll -> its game's frame then (its status file), the slowest it ran since
    start_failed = {}                # doll -> when its start failed (another one is tried meanwhile)
    said_why = {}                    # (v150-host beta 16) bot -> the reason last said for its dolls not started (say_why)
    sums_written, sums_at = None, 0.0
    guard = PaceGuard()              # (v141 beta 9) the pace guard
    steal = Steal()                  # (v141 beta 9) the share of the processors the VPS's machine takes
    vpace = VdollPace()              # (v150-host beta 16) a bot slowed while its virtual dolls play: said
    say('started (%d dolls set up)' % len(dolls(gate_on())))
    while True:
        accountless = gate_on()
        senv = env_file(f'{ETC}/server.env')
        FAST_S = fast_seconds(senv)                  # (v150-host beta 18) the watchdog's delay for a silent bot
        # changed live (MGO1 Host.exe); (v141 beta 3) the dolls listed in TX-55's game list: a seat always kept (the list
        # would show the game full, no real player could come in)
        keep_seat = senv.get('DOLL_KEEP_SEAT', '1') != '0' or (senv.get('DOLL_GATE', '1') != '0' and senv.get('DOLL_LIST', 'host') != 'off')
        listed = senv.get('DOLL_LIST', 'host') != 'off'    # (v150-host beta 16: the virtual dolls are listed so with DOLL_GATE=0 too)
        units = [f'mgo1host@{b}' for b in range(1, MAX_BOTS + 1)] + [f'mgo1doll@{n}' for n in range(1, MAX_DOLLS + 1)]
        st = states(units)
        now = time.time()

        def running(unit):
            return st.get(unit, 'unknown') in RUNNING
        # (v150-host beta 16) the watchdog first: nothing later in a round (a file that cannot be written, a full disk) may
        # keep a hung game from its restart
        ds = dolls(accountless)
        bots_on = [b for b in range(1, MAX_BOTS + 1) if os.path.exists(f'{ETC}/bot{b}.env') and running(f'mgo1host@{b}')]
        running_units = [(f'mgo1host@{b}', f'{VAR}/bot{b}/run/status.json', f'bot{b}') for b in bots_on
                         if st.get(f'mgo1host@{b}') == 'active'] + \
                        [(f'mgo1doll@{d["n"]}', f'{VAR}/doll{d["n"]}/status.json', f'doll{d["n"]}') for d in ds
                         if st.get(f'mgo1doll@{d["n"]}') == 'active']
        for u in [u for u in active_since if u not in {x[0] for x in running_units}]:
            active_since.pop(u, None)
            MISSING.pop(u, None)
        watchdog(running_units, active_since, now)
        if doll_counts(accountless, st):
            st = states(units)
        ds = dolls(accountless)
        # the dolls' names: an accountless doll's is its DOLL_NAME, else DOLL_<N>; another's from its status file once
        # its identity is known, kept in /var/lib/mgo1host/doll<N>/name
        name_of, by_name = {}, {}
        for d in ds:
            if not d['account']:
                nm = d['name']
            else:
                s = read_json(f'{VAR}/doll{d["n"]}/status.json') or {}
                nm = str(s.get('name') or '').strip().split('\n')[0][:32]
                path = f'{VAR}/doll{d["n"]}/name'
                kept = (safe_read(path, 64) or '').strip().split('\n')[0]   # (its first line: a name, nothing else of a file)
                if nm and s.get('identity', 'name') != 'unknown':
                    if kept != nm:
                        try:
                            safe_write(path, nm + '\n', make=True)
                        except OSError:                    # (not kept: its status tells it again)
                            pass
                else:
                    nm = kept
            if nm:
                name_of[d['n']] = nm.upper()
                by_name.setdefault(nm.upper(), []).append(d['n'])
        same = sorted((k, tuple(v)) for k, v in by_name.items() if len(v) > 1)
        if same != said_same:
            for k, v in same:
                say('dolls %s report the same name %s: one of them is not that player' % (', '.join(map(str, v)), k), 'W')
            said_same = same
        names = set(by_name)
        text = ''.join(sorted(n + '\n' for n in names))
        if text != names_written:
            try:
                safe_write(f'{VAR}/dolls.names', text, make=True)
                names_written = text
                write_failed(f'{VAR}/dolls.names')
            except OSError as e:
                write_failed(f'{VAR}/dolls.names', e, 'the dolls keep the names they have')
        text = follow_levels(ds)                         # (before any start: a doll reads its line at its start)
        if text != levels_written:
            try:
                safe_write(f'{VAR}/dolls.levels', text, make=True)
                levels_written = text
                write_failed(f'{VAR}/dolls.levels')
            except OSError as e:
                write_failed(f'{VAR}/dolls.levels', e, 'a doll at its bot\'s virtual dolls\' level starts with the last one written, or 5')
        known = {d['n'] for d in ds}
        # a doll service running without its settings file: stopped
        for n in range(1, MAX_DOLLS + 1):
            if n not in known and st.get(f'mgo1doll@{n}') in ('active', 'activating'):
                if systemctl('stop', f'mgo1doll@{n}'):
                    st[f'mgo1doll@{n}'] = 'inactive'
                say('doll %d: stopped (no settings file)' % n)
        steal.look(now)
        for b in bots_on:                                  # (v150-host beta 16; a bot with no full doll too)
            vpace.look(b, read_json(f'{VAR}/bot{b}/run/status.json') or {}, steal)
        vdolls_on = sum(vdolls_set(read_json(f'{VAR}/bot{b}/run/status.json')) for b in bots_on)
        budget = capacity(len(bots_on), vdolls_on)         # the dolls the server's cores and memory allow
        if budget != said_budget:
            say('the server can run %d dolls at once besides its %d bots%s' % (budget, len(bots_on),
                ' and their %d virtual dolls' % vdolls_on if vdolls_on else ''))
            said_budget = budget
        total, sums_now = budget, {}
        for bot in sorted({d['bot'] for d in ds}):
            mine = [d for d in ds if d['bot'] == bot]
            status = read_json(f'{VAR}/bot{bot}/run/status.json') or {}
            there, unit = os.path.exists(f'{ETC}/bot{bot}.env'), st.get(f'mgo1host@{bot}', 'unknown')
            hosting = there and status.get('state') == 'hosting' and unit == 'active'
            players = [p for p in status.get('players', []) if not p.get('host')]
            game = status.get('game', {})
            try:
                most = int(game.get('max') or game_settings(bot).get('max_players', 9))
            except ValueError:
                most = 9
            seats = max(0, most - 1)                          # the dedicated host takes one
            # (v150-host beta 16: a virtual doll's name is not a playable doll's, the owner's had the same ones)
            in_game = {p.get('name', '').upper() for p in players if not p.get('vdoll')}
            # (v141 beta 6) the host's own word when it gives it (its session table: each player's kind, an accountless doll's
            # number from its user id): a doll in the game is found whatever its name; else the names, as before
            kinds = bool(players) and all('kind' in p for p in players)
            dolls_in = {p.get('doll') for p in players if p.get('doll')}
            real = [p for p in players if p.get('kind') == 'real'] if kinds else [p for p in players if p.get('name', '').upper() not in names]
            # the enabled dolls running (a disabled one is stopped below, for that reason)
            on = [d for d in mine if d['enabled'] and running(f'mgo1doll@{d["n"]}')]
            # a doll running and not in the game yet holds its seat; past DOLL_JOIN_TIMEOUT it starts again
            # (a doll whose name is not known yet cannot be looked for: neither waiting nor started again)
            waiting = []
            for d in on:
                n = d['n']
                if (not d['account'] and n in dolls_in) or n not in name_of or name_of[n] in in_game:
                    pending_since.pop(n, None)
                    continue
                t0 = pending_since.setdefault(n, now)
                if pending_frame.get(n, {}).get('t0') != t0:          # (v141 beta 9) its game's frame when it was missed
                    pending_frame[n] = {'t0': t0, 'at': doll_frame(n)[0], 'said': False}
                waiting.append(n)
                if hosting and n not in leaving and now - t0 > JOIN_WAIT and join_late(n, now, t0, pending_frame):
                    # (v141 beta 6) what was looked for and what was there, before the restart (no account, no password)
                    acct = {name_of[x['n']]: x['n'] for x in ds if x['account'] and x['n'] in name_of}
                    say('doll %d: join timeout: %s' % (n, join_diag(d, name_of.get(n, ''), players, int(now - t0), acct)), 'W', f'doll{n}')
                    systemctl('restart', f'mgo1doll@{n}')
                    pending_since[n] = now
                    say('doll %d: not in bot %d\'s game %d s after its start: started again' % (n, bot, int(now - t0)), 'W', f'doll{n}')
            for n in [n for n in pending_since if n not in {d['n'] for d in on} and n in {d['n'] for d in mine}]:
                pending_since.pop(n, None)
            for n in [n for n in pending_frame if n not in pending_since]:
                pending_frame.pop(n, None)
            # (v141 beta 9) the pace guard: its dolls in the game and the bot itself, their "pace:" minutes
            guarded = senv.get('DOLL_PACE_GUARD', '1') != '0'
            if hosting and guarded:
                ins = [d for d in on if d['n'] not in waiting and d['n'] not in leaving]
                guard.look(bot, dict([(f'bot{bot}', f'{VAR}/bot{bot}/run/status.json')] +
                                     [(f'doll{d["n"]}', f'{VAR}/doll{d["n"]}/status.json') for d in ins]), len(ins), len(real), now, steal.pct)
                guard.lift(bot, len([d for d in mine if d['enabled']]))
            # the dolls that may play now: the seats of its game less its real players, the seats of its virtual dolls (docs/
            # VIRTUAL_DOLL.md: its status's vdolls_set, its game's own players), the seat kept; the server's budget; the pace
            # guard's cap. (v150-host beta 16) Fewer than those set: why, said once a reason (doll_sums, say_why)
            found = [d for d in mine if d['enabled'] and ((not d['account'] and d['n'] in dolls_in) or (d['n'] in name_of and name_of[d['n']] in in_game))]
            # (v150-host beta 16) the seat kept: the game's own rule for its virtual dolls too (mgo1host.sh's MGO1_VDOLL_KEEP_SEAT:
            # one kept unless DOLL_KEEP_SEAT=0 and DOLL_LIST=off, whatever DOLL_GATE), so that both sides count the same seats
            keep_here = keep_seat or (listed and vdolls_set(status) > 0)
            sums = doll_sums(bot, there, unit, str(status.get('state') or ''), most, len(real), vdolls_set(status), keep_here,
                             len([d for d in mine if d['on']]), len([d for d in mine if d['on'] and not d['enabled']]), budget, total,
                             guard.cap(bot) if guarded else None, guard.wait(bot, now) if guarded else 0, len(found))
            want, vres = sums['want'], sums['vdolls']
            budget -= want
            say_why(bot, sums, said_why)
            sums_now[str(bot)] = dict({'waiting_code': sums['code'], 'waiting_why': sums['why']}, **{k: sums[k] for k in SUMS_KEYS})
            # too many: the ones not in the game yet stopped first, then the last ones leave (their leave order,
            # then a stop if they have not gone in 30 s)
            for d in sorted(on, key=lambda d: (d['n'] not in waiting, -d['n']))[:max(0, len(on) - want)]:
                n, t = d['n'], leaving.get(d['n'])
                if n in waiting and t is None:
                    if systemctl('stop', f'mgo1doll@{n}'):
                        st[f'mgo1doll@{n}'] = 'inactive'
                    pending_since.pop(n, None)
                    say('doll %d: stopped (not in bot %d\'s game yet and its seat needed: %d real players, %d seats%s)' % (
                        n, bot, len(real), seats, ', one kept for a real player' if keep_here else ''))
                elif t is None:
                    order(n, 'leave')
                    leaving[n] = now
                    say('doll %d: told to leave bot %d\'s game (%d real players, %d seats%s)' % (
                        n, bot, len(real), seats, ', one kept for a real player' if keep_here else ''))
                elif now - t > LEAVE_WAIT:
                    if systemctl('stop', f'mgo1doll@{n}'):
                        st[f'mgo1doll@{n}'] = 'inactive'
                    leaving.pop(n, None)
                    say('doll %d: stopped (still there %d s after its leave order)' % (n, LEAVE_WAIT), 'W')
            for d in mine:
                if d['n'] in leaving and not running(f'mgo1doll@{d["n"]}'):
                    leaving.pop(d['n'], None)
            on = [d for d in mine if d['enabled'] and running(f'mgo1doll@{d["n"]}')]
            # too few: the next enabled one starts (one start every START_GAP seconds for the whole server; a
            # doll whose start failed waits 5 minutes, the next one is tried)
            if len(on) < want and now - last_start >= START_GAP:
                for d in mine:
                    n = d['n']
                    if d['enabled'] and d not in on and n not in leaving and now - start_failed.get(n, -1e9) > 300:
                        last_start = now
                        if systemctl('start', f'mgo1doll@{n}'):
                            st[f'mgo1doll@{n}'] = 'activating'
                            pending_since[n] = now
                            start_failed.pop(n, None)
                            say('doll %d: started for bot %d\'s game (%d real players, %d seats%s)' % (n, bot, len(real), seats,
                                                                                ', %d for its virtual dolls' % vres if vres else ''))
                        else:
                            start_failed[n] = now
                        break
        # (v150-host beta 16) what was counted for each bot, for whoever looks (/var/lib/mgo1host/dolls.sums.json; mgo1host-agent
        # counts the same for its `dolls`): written when it changes, the pace guard's wait once a minute
        text = json.dumps({'budget': total, 'bots': {b: dict(v, pace_wait_s=0) for b, v in sums_now.items()}}, sort_keys=True)
        if text != sums_written or now - sums_at >= 60:
            try:
                safe_write(f'{VAR}/dolls.sums.json', make=True, text=json.dumps({'t': int(now), 'budget': total, 'bots': sums_now}, sort_keys=True))
            except OSError:
                pass
            sums_written, sums_at = text, now
        # disabled dolls that still run (or with no account while DOLL_GATE=0): stopped
        for d in ds:
            if not d['enabled'] and running(f'mgo1doll@{d["n"]}') and st.get(f'mgo1doll@{d["n"]}') != 'unknown':
                if systemctl('stop', f'mgo1doll@{d["n"]}'):
                    st[f'mgo1doll@{d["n"]}'] = 'inactive'
                say('doll %d: stopped (disabled%s)' % (d['n'], '' if d['account'] or accountless else ': no account, and DOLL_GATE=0'))
        rounds += 1
        if ROUNDS and rounds >= ROUNDS:
            return
        time.sleep(PERIOD)


if __name__ == '__main__':
    try:
        if sys.argv[1:] == ['--counts']:
            doll_counts(gate_on())
            sys.exit(0)
        main()
    except KeyboardInterrupt:
        sys.exit(0)
    except Exception as e:                           # its service starts it again in 5 s
        say('stopped by an error: %s: %s' % (type(e).__name__, e), 'E')
        raise
