# SaveMGO MGO1 dedicated host: one bot (/etc/mgo1host/bot<N>.env), then: systemctl restart mgo1host@<N>
# (no comment at the end of a line: systemd would read it as part of the value)

# The SaveMGO account this bot logs in with (one account a bot, kept for the bot only).
# Capitals, digits, - _ . (MGO1 accounts are in capitals; small letters are typed as capitals).
HOST_ACCOUNT_ID=
HOST_ACCOUNT_PASSWORD=

# UDP port of this bot's game (MGO1's [UDP Port No.]): 5730 to 5739, one a bot, open in the firewalls
UDP_PORT=5730

# The game's settings (name, comment, password, rules and maps, times, switches) are in
# /etc/mgo1host/bot<N>.game (mgo1hostctl -b <N> edit); a key left out keeps the account's last
# settings, which the lobby returns. Host Only is always set.

# Its accountless PLAYABLE DOLLs (DOLL_<N>, no account; docs/PLAYABLE_DOLL.md 1): how many (0 to 16); MGO1 Host.exe's
# DOLLS page sets it with + and -, mgo1doll-manager adds or removes their settings files to match. Unset: the
# dolls are the doll<N>.env files there are. A doll added while this bot has virtual dolls set
# (VDOLL_COUNT above 0, or a VDOLL_LEVEL below) plays at their level (its DOLL_DIFFICULTY=vdoll), else at 3. The virtual
# dolls hold their seats first: a game of 9 with 3 of them and the seat kept for a real player has 4 seats for these
# (the manager's log and mgo1host-agent dolls say when fewer can start than are set).
#DOLL_COUNT=3

# Its virtual dolls (docs/VIRTUAL_DOLL.md): players this bot's game runs itself, no game, no account and no processor of
# their own; how many (0 to 15, one seat of the game always left for a real player), their teams (red, blue, auto: one a
# doll, the last for the rest; auto: their turns to the side with fewer players). Their names: /etc/mgo1host/bot<N>.vdolls,
# a name a line (else VDOLL1 ..). Their level (docs/VIRTUAL_DOLL.md 11): 1 (slow to react, aims wide, sees 16 m) to 10
# (reacts at once, aims true, sees 80 m), 5 when unset; or one a doll, the last for the rest (3,5,7). MGO1 Host.exe's
# VIRTUAL DOLLS page sets them (mgo1host-agent vdoll-set); taken at the bot's next game. The playable
# dolls set to follow them (DOLL_DIFFICULTY=vdoll) take VDOLL_LEVEL the same way.
#VDOLL_COUNT=2
#VDOLL_TEAMS=auto
#VDOLL_LEVEL=5

# how its virtual dolls turn, aim and fire: direct (the default, as before) or player: within what the
# pad lets a player do (they turn their view at the pace a stick allows, then aim and fire); with a PLAYABLE DOLL's direct
# aim too (DOLL_AIM) the two kinds were of about equal strength at level 5 (10-minute duels). MGO1 Host.exe's VIRTUAL DOLLS page: CONTROLS (mgo1host-agent vdoll-set's "controls"); taken at the
# bot's next game. Another word: direct (mgo1host.sh's log says so)
#VDOLL_CONTROLS=direct

# its virtual dolls' live level (docs/DEDICATED_HOST.md 22): 1, the level of each virtual doll follows
# the strength of the game's real players (their kills and deaths, VS RATING, the teams' score), between VDOLL_ADAPT_MIN and
# VDOLL_ADAPT_MAX (1 to 10; 1 and 10 when unset); VDOLL_LEVEL is where it starts. 0 or unset: off, the level set (the
# default: as before). MGO1 Host.exe's VIRTUAL DOLLS page sets them; a running game takes a change within 2 s (no restart).
# The playable dolls set to follow the virtual dolls (DOLL_DIFFICULTY=vdoll) keep VDOLL_LEVEL, the level set.
#VDOLL_ADAPT=0
#VDOLL_ADAPT_MIN=1
#VDOLL_ADAPT_MAX=10

# this bot's own JOINER_HOLD_S (0 to 300 s, docs/DEDICATED_HOST.md 21), over server.env's: how long its
# game keeps a joiner still loading past the game's silence rules; unset: server.env's, else the game's 60
#JOINER_HOLD_S=60
