            "loadout": kv.get("DOLL_LOADOUT", "auto"), "order": kv.get("DOLL_ORDER", "free"),
            "adapt": kv.get("DOLL_ADAPT", "1") != "0" and not follows(kv), "aim": doll_aim_of(kv),
            "running": state in ("active", "activating"), "state": state, "age": age,
            "status": redact_event(st, secrets()) if st else {}}


def doll_name(n, kv=None):
    """(v141 beta 5) An accountless doll's name in the game: its DOLL_NAME when valid, else DOLL_<n>."""
    v = (kv if kv is not None else read_kv(doll_env(n))).get("DOLL_NAME", "")
    return v if DOLL_NAME_RE.match(v) and "  " not in v else "DOLL_%d" % n


def check_doll_name(name, n):
    """(v141 beta 5) A name asked for doll n (0: a doll to be added): valid and no other doll's (whatever the case). The
    game shows it as typed; a real player of the same name would be taken for a doll by the dolls."""
    if not DOLL_NAME_RE.match(name) or "  " in name:
        raise Fail("a doll's name: 3 to 15 letters, digits, spaces and . _ - ! ? + *", "doll_name", name)
    if DOLL_DEFAULT_RE.match(name):
        raise Fail("DOLL_<number> names are the dolls' own", "doll_name_default", name)
    for o in dolls():
        if o == n:
            continue
        kv = read_kv(doll_env(o))
        other = doll_name(o, kv) if not kv.get("DOLL_ACCOUNT_ID") else ""
