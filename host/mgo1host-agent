# ---- (v150-host beta 22, sync) the game settings: one copy saved (bot<N>.game), what the running game plays, this server's maps
# MGO1 Host's GAME page and the bot's file are the same settings: bot<N>.game is the one copy every reader takes (the next
# game's launcher, the doll lobby's listing until the game says its own). What a running game plays is the copy its launcher
# made at its start (run/game.src, exact; run/game.ini, what the game read: less the maps this server does not have) and the
# rotation it made (its status's): a save reaches the next game, or this one at once with --restart. settings-get says
# which keys the running game does not play yet ("pending"), the rotation's entries it left out ("left_out"), this
# server's maps ("maps_here") and the saved copy's version, which settings-set --base <version> checks (a form older than
# the file refused: "settings_changed", nothing written).
def game_text(n=None):
    """bot<N>.game's text ("" when there is none)."""
    try:
        with open(bot_game(n), encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def settings_version(text):
    """A settings file's version: the first 16 hex digits of its text's SHA-256; "" for none or an empty one."""
    return hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()[:16] if text.strip() else ""


def rotation_pairs(v):
    """A rotation's text as [(rule, map)], in its order."""
    return [(int(a), int(b)) for a, b in re.findall(r"(\d+)\s*:\s*(\d+)", str(v or ""))]


def settings_norm(kv):
    """Settings as the game takes them, to compare two copies: the rotation as its pairs, the switches in small letters, the
    numbers as numbers; an unknown key as it is."""
    out = {}
    for k, v in kv.items():
        v = str(v).strip()
        kind = SETTING_KEYS.get(k, ("text",))[0]
        if kind == "rotation":
            out[k] = rotation_pairs(v)
        elif kind == "switch":
            out[k] = v.lower()
        elif kind == "int" and re.fullmatch(r"\d+", v):
            out[k] = int(v)
        else:
            out[k] = v
    return out


def maps_dir(n=None):
    """The PC maps' folder bot n's game is given (host/mgo1host.sh: MAPS_DIR from server.env or bot<N>.env, else the
    install's maps folder)."""
    kv = read_kv(SERVER_ENV)
    kv.update(read_kv(bot_env(n)))
    return kv.get("MAPS_DIR") or os.path.join(HOME_DIR, "maps")


def maps_here(n=None):
    """The map numbers bot n's games can play: the twelve disc maps, and each PC map (13 ..) of the table whose folder in the
    maps folder holds a map.ini naming it (id = 13; the game reads them so). A PC map whose files are there but which the game
    cannot build from this disc is left out by the game itself (settings-get's "left_out")."""
    here = {m["id"] for m in MAPS if not m["pc_only"]}
    for ini in glob.glob(os.path.join(maps_dir(n), "*", "map.ini")):
        try:
            with open(ini, encoding="utf-8", errors="replace") as f:
                ids = [int(m.group(1)) for m in (re.match(r"\s*id\s*=\s*(\d+)", line) for line in f) if m]
            if ids:
                here.add(ids[-1])                    # (sync2, the review's S6: the last id line, as the game reads it)
        except OSError:
            pass
    return sorted(i for i in here if any(m["id"] == i for m in MAPS))


def game_running(n=None):
    """What bot n's running (or starting) game plays: {"started": the settings its launcher copied at its start (run/game.src;
    a launcher before beta 22: run/game.ini), "made": the rotation its status says it made ([(rule, map)]; None before it
    says it), "real": its real players now}; None when no game of it runs."""
    run = os.path.join(bot_state(n), "run")
    svc, _ = service_state(n)
    proc = host_process(n)
    # (sync2, the review's S5) no game process and the service "activating": a start waiting (its ExecStartPre's wait after
    # early ends, or systemd's 5 s before a restart), the run folder still the last game's: no game runs. "active" with no
    # game process: its launcher is starting it (the run folder its own, game.src the file as it is now)
    if proc is None and svc != "active":
        return None
    src = safe_read(os.path.join(run, "game.src"))
    started = src if src is not None else safe_read(os.path.join(run, "game.ini"))
    if started is None:
        return None
    host, age = read_status(n)
    made, real = None, 0
    if proc is not None and host and age is not None and age < 60:
        rules = (host.get("game") or {}).get("rules")
        if isinstance(rules, list) and rules:
            try:
                made = [(int(p[0]), int(p[1])) for p in rules]
            except (TypeError, ValueError, IndexError):
                made = None
        real, _ = player_kinds([p for p in host.get("players", []) if isinstance(p, dict) and not p.get("host")])
    return {"started": settings_parse(started), "made": made, "real": real, "process": proc is not None}


def settings_sync(saved, n=None):
    """settings-get's and settings-set's account of a bot's settings: the saved copy's version, the running game's settings
    ("applied", None when none runs), the keys saved that it does not play yet ("pending"), the rotation's entries it left
    out ("left_out", "r:m"), this server's maps, its real players."""
    run = game_running(n)
    res = {"version": settings_version(saved), "maps_here": maps_here(n), "running": run is not None, "applied": None,
           "applied_rotation": None, "pending": [], "left_out": [], "real_players": run["real"] if run else 0, "settings_sync": True}
    if run is None:
        return res
    now, was = settings_norm(settings_parse(saved)), settings_norm(run["started"])
    res["applied"] = run["started"]
    res["pending"] = [k for k in list(SETTING_KEYS) + sorted(set(now) | set(was)) if (k in now or k in was) and now.get(k) != was.get(k)]
    res["pending"] = list(dict.fromkeys(res["pending"]))
    if run["made"] is not None:
        res["applied_rotation"] = ", ".join("%d:%d" % p for p in run["made"])
        res["left_out"] = list(dict.fromkeys("%d:%d" % p for p in was.get("rotation", []) if p not in run["made"]))
    return res


