    write_atomic(timer, "[Unit]\nDescription=MGO1 dedicated host: the daily restart\n\n[Timer]\n"
                 "OnCalendar=*-*-* %s:00\nPersistent=false\n\n[Install]\nWantedBy=timers.target\n" % args[0])
    systemctl("daemon-reload")
    rc, so, se = systemctl("enable", "--now", "mgo1host-restart.timer")
    if rc:
