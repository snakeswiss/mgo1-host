# (v150-host beta 16) the commands that write settings: one at a time (each reads a file, changes its keys and writes it
# back: two at once lost the first one's keys), the others wait their turn
WRITES = {"settings-set", "account-set", "servers-set", "schedule-set", "host-list-9", "host-unranked", "bot-add", "bot-remove", "bot-port",
          "doll-set", "doll-remove", "doll-order", "doll-all", "doll-count", "doll-keep-seat", "doll-list", "vdoll-set", "vdoll-count",
          "blacklist-add", "blacklist-remove", "whitelist-add", "whitelist-remove", "whitelist-only", "ban", "unban"}
LOCK = None                                                  # (held to this call's end)


def writers_turn():
    """This call's turn among the commands that write: the lock /etc/mgo1host/.agent.lock, waited for MGO1_AGENT_LOCK_WAIT
    seconds at most (150: another call may be adding dolls or starting a game again), then refused (busy)."""
    global LOCK
    import fcntl
    try:
        LOCK = open(os.path.join(CONF, ".agent.lock"), "a")
    except OSError:
        return                                               # (no settings folder yet: nothing to share)
    end = time.time() + float(os.environ.get("MGO1_AGENT_LOCK_WAIT", "150"))
    while True:
        try:
            fcntl.flock(LOCK, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except OSError:
            if time.time() >= end:
                raise Fail("another command is still writing this server's settings", "busy")
            time.sleep(0.05)


def main(argv):
    global BOT
    try:
        os.nice(5)                                   # (v141 beta 4) the games first: the agent waits a little when busy
    except OSError:
        pass
    if "--bot" in argv:
        i = argv.index("--bot")
        if i + 1 >= len(argv) or not argv[i + 1].isdigit() or not 1 <= int(argv[i + 1]) <= MAX_BOTS:
            raise Fail("--bot 1 to %d" % MAX_BOTS, "usage", "--bot 1 to %d" % MAX_BOTS)
        BOT = int(argv[i + 1])
        argv = argv[:i] + argv[i + 2:]
    if not argv:
        raise Fail("a command: see mgo1host-agent's first lines", "usage", "mgo1host-agent")
    c, args = argv[0], argv[1:]
    if c in WRITES:
        writers_turn()
    simple = {
        "version": lambda: {"ok": True, "agent": AGENT_VERSION, "bots": bots()},
        "sysinfo": cmd_sysinfo, "bots": cmd_bots, "firewall": cmd_firewall,
        "restart": cmd_restart, "settings-get": cmd_settings_get, "account-get": cmd_account_get,
        "account-set": cmd_account_set, "schedule-get": lambda: {"ok": True, "schedule": schedule_now()},
        "scheduled-restart": cmd_scheduled_restart, "servers-get": cmd_servers_get, "redact": cmd_redact,
        "dolls": cmd_dolls, "vdolls": cmd_vdolls,
    }
    if c in simple:
        return simple[c]()
    if c == "status":
        need_bot()
        res, prev = status()
        time.sleep(0.5)
        res2, _ = status(prev)
        return res2
    with_args = {
