    v = read_kv(SERVER_ENV).get("HOST_UNRANKED", "auto")
    return v if v in ("auto", "always", "off") else "auto"


# ---- (v150-host beta 16) why a bot's playable dolls do not start: mgo1doll-manager's own sums, counted here too ----
# the states of a unit that has, or is about to have, a game (mgo1doll-manager's RUNNING)
RUNNING = ("active", "activating", "reloading", "deactivating", "unknown")
SUMS_KEYS = ("seats", "real", "vdolls", "kept", "free_for_dolls", "dolls_set", "dolls_in", "pace_cap", "pace_wait_s")


def doll_sums(bot, exists, unit, state, most, real, vset, keep_seat, dolls_set, no_gate, budget, capacity, cap, cap_wait, dolls_in):
    """(v150-host beta 16) One bot's playable dolls: how many may play now (want) and, when fewer than those set, why: a code
    (bot_stopped, not_hosting, seats, server_full, pace_guard, gate_off), its words for the daily log and their level (W: a
    setting the owner must change). exists: the bot's settings file is there; unit: its service's state; state: its
    status's; most: its game's players, the host one of them; real: the real players in it; vset: its virtual dolls wanted
    (its status's vdolls_set); dolls_set: its dolls with DOLL_ENABLED=1, no_gate of them accountless while DOLL_GATE=0;
    budget: the dolls the server can still run, capacity: in all; cap, cap_wait: the pace guard's most for the bot (None:
    none) and the seconds before one more at the soonest; dolls_in: its dolls in its game now.
    The same sum as mgo1doll-manager's doll_sums, which decides (the agent cannot load it: a copy; tests/test_doll_manager.py
    part 24 gives both the same folders and compares)."""
    seats = max(0, most - 1)                              # the dedicated host takes one
    kept = 1 if keep_seat else 0
    vres = max(0, min(vset, seats - kept))                # its virtual dolls hold their seats (docs/VIRTUAL_DOLL.md 6)
    hosting = exists and unit == 'active' and state == 'hosting'
    if not hosting:
        real = dolls_in = 0
    free = max(0, seats - real - vres - kept)
    can = dolls_set - no_gate
    want = min(can, free, budget) if hosting else 0
    if cap is not None:
        want = min(want, cap)
    want = max(0, want)
    code, why, level, sig = '', '', 'I', None
    if dolls_set and want < dolls_set:
        s = '' if dolls_set == 1 else 's'
        wait = "bot %d's playable doll%s (%d) wait%s: " % (bot, s, dolls_set, 's' if dolls_set == 1 else '')
        some = 'bot %d: %d playable doll%s set, %s can start: ' % (bot, dolls_set, s, 'only %d' % want if want else 'none')
        head = some if want else wait
        fit = max(0, seats - vres - kept)                 # the most that ever play, with no real player in
        if can == 0:                                      # (none of them may play, whatever its bot does)
            code, level = 'gate_off', 'W'
            why = wait + 'no account, and DOLL_GATE=0 in server.env (no accountless doll on this server)'
        elif not exists:
            code, level, sig = 'bot_stopped', 'W', (False, '')
            why = wait + 'there is no bot %d on this server (their DOLL_BOT: remove them, or give them another bot)' % bot
        elif unit not in RUNNING or unit == 'deactivating':
            code, level, sig = 'bot_stopped', 'W', (True, unit)
            why = wait + 'bot %d is not running (its service is %s)' % (bot, unit)
        elif not hosting:
            code = 'not_hosting'
            why = wait + 'its game is not hosting yet (%s)' % ('its service is %s' % unit if unit != 'active' else
                                                                'state %s' % state if state else 'no status yet')
        elif want == free:
            code, sig = 'seats', (seats, vres, kept, fit < can)
            why = some + 'its game has %d seat%s (max_players %d)%s%s%s' % (
                seats, '' if seats == 1 else 's', most, ', %d for its virtual dolls' % vres if vres else '',
                ', 1 kept for a real player' if kept else '', ', %d real player%s' % (real, '' if real == 1 else 's') if real else '')
            if fit < can:                                 # (its settings alone: never all of them, whoever plays)
                level = 'W'
                why += '; %s whatever the players (more max_players or fewer virtual dolls)' % (
                    'only %d of them can ever play' % fit if fit else 'none of them can ever play')
        elif want == budget:
            code, level = 'server_full', 'W' if capacity <= 0 else 'I'
            why = head + 'the server can run %d %sdoll%s now (%d in all besides its bots and their virtual dolls)' % (
                budget, 'more ' if capacity > budget else '', '' if budget == 1 else 's', capacity)
        elif cap is not None and want == cap:
            code = 'pace_guard'
            why = head + 'the pace guard allows %d%s (its game ran below its pace; DOLL_PACE_GUARD=0 in server.env: no guard)' % (
                cap, ' for %d more minute%s at least' % ((cap_wait + 59) // 60, '' if (cap_wait + 59) // 60 == 1 else 's') if cap_wait > 0 else '')
        else:
            code, level = 'gate_off', 'W'
            why = some + '%d of them have no account, and DOLL_GATE=0 in server.env' % no_gate
    return {'want': want, 'code': code, 'why': why, 'level': level, 'sig': (code, want == 0, dolls_set, sig) if code else None,
            'seats': seats, 'real': real, 'vdolls': vres, 'kept': kept, 'free_for_dolls': free, 'dolls_set': dolls_set,
            'dolls_in': dolls_in, 'pace_cap': cap, 'pace_wait_s': int(cap_wait) if cap is not None else 0}


def doll_budget(active_bots, vdolls):
    """The dolls the server can run now besides its running bots and their virtual dolls, as mgo1doll-manager counts them (its
    capacity(): a bot 0.35 of a core and 350 MB, a doll 0.4 and 250 MB, a virtual doll 0.03 of a core, a quarter of the cores
    left free, the VPS's steal since the server's start taken off)."""
    mem = int(os.environ.get("MGO1_MEM_MB", "0"))        # (tests: the machine's memory and cores given, as the manager's)
    try:
        for line in open("/proc/meminfo") if not mem else ():
            if line.startswith("MemTotal:"):
                mem = int(line.split()[1]) // 1024
    except OSError:
        pass
    steal = 0.0
    try:
        with open(os.environ.get("MGO1_PROC_STAT", "/proc/stat")) as f:
            v = [int(x) for x in f.readline().split()[1:]]
        steal = 100.0 * v[7] / sum(v[:8]) if len(v) > 7 and sum(v[:8]) else 0.0
    except (OSError, ValueError, IndexError):
        pass
    cores = (int(os.environ.get("MGO1_CORES", "0")) or os.cpu_count() or 1) * (1.0 - min(80.0, steal) / 100.0)
    cores, left = cores * 0.75 - 0.35 * active_bots - 0.03 * vdolls, mem - 400 - 350 * active_bots
    return max(0, min(MAX_DOLLS, int(cores / 0.4), int(left / 250)))


def json_file(path):
    try:
        with open(path, encoding="utf-8") as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def dolls_waiting():
    """(budget, {bot: its sums}): for each bot, and each bot dolls are set for, what mgo1doll-manager counts for its playable
    dolls each round (its main loop: the bots in their order share the server's budget): the seats, the real players, the
    virtual dolls' seats, the dolls that may play and, when fewer than those set, why (doll_sums)."""
    senv = read_kv(SERVER_ENV)
    gate = senv.get("DOLL_GATE", "1") != "0"
    keep_seat = senv.get("DOLL_KEEP_SEAT", "1") != "0" or (gate and senv.get("DOLL_LIST", "host") != "off")
    guarded = senv.get("DOLL_PACE_GUARD", "1") != "0"
    ds, names = [], set()
    for n in dolls():
        kv = read_kv(doll_env(n))
        acc = bool(kv.get("DOLL_ACCOUNT_ID"))
        if acc:                                            # (its name once it knows who it is, else the last one known)
            st = json_file(os.path.join(doll_state(n), "status.json"))
            nm = st.get("name") or ""
            if not nm or st.get("identity", "name") == "unknown":
                try:
                    with open(os.path.join(doll_state(n), "name")) as f:
                        nm = f.read().strip()
                except OSError:
                    nm = ""
        else:
            nm = doll_name(n, kv)
        on = kv.get("DOLL_ENABLED", "1") == "1"
        ds.append({"n": n, "bot": doll_bot(n), "account": acc, "on": on, "enabled": on and (acc or gate), "name": str(nm).upper()})
        if nm:
            names.add(str(nm).upper())

    def unit_state(b):
        rc, so, _ = systemctl("is-active", "mgo1host@%d" % b)
        return so.strip() or ("unknown" if rc == 127 else "active" if rc == 0 else "inactive")
    have = bots()
    asked = sorted(set(have) | {d["bot"] for d in ds if 1 <= d["bot"] <= MAX_BOTS})
    lines = systemctl("is-active", *["mgo1host@%d" % b for b in asked])[1].split() if asked else []   # (one call, as the manager's)
    units = dict(zip(asked, lines)) if len(lines) == len(asked) else {b: unit_state(b) for b in asked}
    status = {b: json_file(os.path.join(bot_state(b), "run", "status.json")) for b in units}

    def vset(st):
        try:
            return max(0, int(st.get("vdolls_set", 0) or 0))
        except (TypeError, ValueError):
            return 0
    on_bots = [b for b in have if units.get(b, "unknown") in RUNNING]
    total = budget = doll_budget(len(on_bots), sum(vset(status[b]) for b in on_bots))
    pace = json_file(os.path.join(STATE_ROOT, "pace_guard.json")) if guarded else {}
    now, res = time.time(), {}
    for b in sorted(set(have) | {d["bot"] for d in ds}):  # (a bot with no doll too: its seats, what is free for dolls)
        mine = [d for d in ds if d["bot"] == b]
        st = status.get(b) or {}
        players = [p for p in st.get("players", []) if isinstance(p, dict) and not p.get("host")]
        game = st.get("game") or {}
        try:
            most = int(game.get("max") or read_kv(bot_game(b)).get("max_players", 9))
        except ValueError:
            most = 9
        in_game = {str(p.get("name", "")).upper() for p in players if not p.get("vdoll")}
        numbers = {p.get("doll") for p in players if p.get("doll")}
        kinds = bool(players) and all("kind" in p for p in players)
        real = [p for p in players if p.get("kind") == "real"] if kinds else [p for p in players if str(p.get("name", "")).upper() not in names]
        found = [d for d in mine if d["enabled"] and ((not d["account"] and d["n"] in numbers) or (d["name"] and d["name"] in in_game))]
        g = pace.get(str(b)) if isinstance(pace.get(str(b)), dict) else {}
        cap, wait = g.get("cap"), 0
        if cap is not None:
            try:
                hold = float(g.get("hold") or 0)
                wait = int(max(0.0, hold - (now - float(g.get("at") or 0)), hold - (now - float(g["ok_since"])) if g.get("ok_since") else hold))
            except (TypeError, ValueError):
                wait = 0
        keep_here = keep_seat or (senv.get("DOLL_LIST", "host") != "off" and vset(st) > 0)   # (the game's rule for its virtual dolls)
        sums = doll_sums(b, b in have, units.get(b, "unknown"), str(st.get("state") or ""), most, len(real), vset(st), keep_here,
                         len([d for d in mine if d["on"]]), len([d for d in mine if d["on"] and not d["enabled"]]), budget, total,
                         cap, wait, len(found))
        budget -= sums["want"]
        res[b] = dict({"waiting_code": sums["code"], "waiting_why": sums["why"]}, **{k: sums[k] for k in SUMS_KEYS})
    return total, res


def cmd_dolls():
    ds = [doll_summary(n) for n in dolls()]
    # each bot's accountless dolls: how many it has, its DOLL_COUNT (null when not set); (v150-host beta 16) and for a bot
    # that has playable dolls, what mgo1doll-manager counts for them: waiting_code ("": they can start; bot_stopped,
    # not_hosting, seats, server_full, pace_guard, gate_off) and waiting_why (its words, the manager's log line), seats (its
    # game's, the host not counted), real (players), vdolls (seats held for its virtual dolls), kept (0 or 1),
    # free_for_dolls, dolls_set (with DOLL_ENABLED=1), dolls_in (in its game now), pace_cap (null: none), pace_wait_s. A bot
    # that is not there and has dolls (their DOLL_BOT) is listed too ("exists": false)
    budget, waiting = dolls_waiting()
    none = dict({"waiting_code": "", "waiting_why": ""}, **{k: None if k == "pace_cap" else 0 for k in SUMS_KEYS})
    counts = {}
    for b in sorted(set(bots()) | set(waiting)):
        there = b in bots()
        v = read_kv(bot_env(b)).get("DOLL_COUNT", "")
        counts[str(b)] = {"accountless": len([d for d in ds if d["bot"] == b and d["accountless"]]),
                          "with_account": len([d for d in ds if d["bot"] == b and not d["accountless"]]),
                          "doll_count": int(v) if v.isdigit() else None, "most": accountless_most(b) if there else 0, "exists": there}
        counts[str(b)].update(waiting.get(b, none))
    rc, so, _ = systemctl("is-active", "mgo1doll-manager")
    return {"ok": True, "dolls": ds, "max": MAX_DOLLS, "capacity": doll_capacity(), "accountless": gate_on(), "bots": counts,
            "keep_seat": read_kv(SERVER_ENV).get("DOLL_KEEP_SEAT", "1") != "0",
            "list": doll_list(), "names": True, "unranked": host_unranked(),
            "budget": budget, "manager": so.strip() or ("active" if rc == 0 else "inactive"),
            # (v150-host beta 16) this server takes the difficulty "vdoll" (doll-set, doll-order, doll-all; DOLL_DIFFICULTY=vdoll):
            # MGO1 Host offers AS THE VIRTUAL DOLLS on a server with no doll yet only when it sees this
            "vdoll_difficulty": True,
            # (v150-host beta 18) this server takes a doll's "aim" (doll-set, doll-order, doll-all; DOLL_AIM): MGO1 Host shows AIM
            # only when it sees this
            "doll_aim": True}


def game_max_players(b):
    """A bot's game's max_players (its settings file; 9 when it has none: 8 players and the host)."""
    try:
        for line in open(os.path.join(CONF, "bot%d.game" % b), encoding="utf-8", errors="replace"):
            m = re.match(r"\s*max_players\s*=\s*(\d+)", line)
            if m:
                return max(2, min(16, int(m.group(1))))
    except OSError:
        pass
    return 9


def accountless_most(b):
    """The most accountless dolls bot b's game takes: its max_players less the host (Host Only) and its dolls with an
    account, within the server's MAX_DOLLS (the other bots' dolls counted)."""
    ds = dolls()
    mine = len([x for x in ds if doll_bot(x) == b and not read_kv(doll_env(x)).get("DOLL_ACCOUNT_ID")])
    others = len([x for x in ds if doll_bot(x) == b and read_kv(doll_env(x)).get("DOLL_ACCOUNT_ID")])
    return max(0, min(MAX_DOLLS - len(ds) + mine, game_max_players(b) - 1 - others))


def cmd_doll_count(args):
    """doll-count <bot> <n>: the bot's accountless dolls (DOLL_<N>, no account): its DOLL_COUNT, applied at once.
    (v141 beta 5) {"name": ...} on stdin: the name in the game of the doll it adds (its DOLL_NAME)."""
    if len(args) != 2 or not args[0].isdigit() or not args[1].isdigit():
        raise Fail("doll-count <bot> <n>", "usage", "doll-count <bot> <n>")
    b, n = int(args[0]), int(args[1])
    name = ""
    if not sys.stdin.isatty():
        try:
            d = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            raise Fail("the settings are not JSON", "bad_json")
        name = str(d.get("name") or "").strip() if isinstance(d, dict) else ""
    if name:
        check_doll_name(name, 0)
    if b not in bots():
        raise Fail("no bot %d on this server" % b, "no_bot", b, ", ".join(map(str, bots())) or "-")
    if not gate_on():
        raise Fail("no accountless doll on this server (DOLL_GATE=0 in server.env)", "dolls_no_gate")
    room = accountless_most(b)
    if n > room:
        raise Fail("bot %d: %d dolls at most (its game's players and the server's %d dolls)" % (b, room, MAX_DOLLS), "dolls_full", b, room)
    with dolls_lock():
        set_env_keys({"DOLL_COUNT": str(n)}, bot_env(b))
    # the dolls added or removed now (the manager would do it within seconds): its own code, under its lock
    mgr = os.environ.get("MGO1_DOLL_MANAGER", "/usr/local/bin/mgo1doll-manager")
    env = dict(os.environ, MGO1_ETC=CONF, MGO1_VAR=STATE_ROOT, MGO1_SYSTEMCTL=tool("systemctl"), MGO1_LOG_DIR=LOG_ROOT)
    if name:                                              # (the manager writes it into the doll it adds, under its lock)
        env.update(MGO1_DOLL_NEW_NAME=name, MGO1_DOLL_NEW_BOT=str(b))
    try:
        subprocess.run([sys.executable, mgr, "--counts"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        pass
    follow_sync(b)
    return cmd_dolls()


def cmd_doll_set(args):
    """A doll's settings: JSON on stdin {"id", "password", "bot", "difficulty", "adapt_min", "adapt_max", "team",
    "enabled"}; the account kept when id / password are left out. A doll with no account is accountless (DOLL_<n>, its
    bot's doll lobby); with DOLL_GATE=0 in server.env a new doll needs its account."""
    n = doll_number(args)
    try:
        d = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        raise Fail("the settings are not JSON", "bad_json")
    kv = read_kv(doll_env(n))
    was = (follows(kv), kv.get("DOLL_BOT"), kv.get("DOLL_ENABLED", "1"))
    if "id" in d or "password" in d:
        aid, apw = str(d.get("id", "")).strip(), str(d.get("password", "")).strip()
        if not (3 <= len(aid) <= 15 and NAME_RE.match(aid)):
            raise Fail("the account ID: 3 to 15 letters, digits, - _ .", "account_id")
        if not (6 <= len(apw) <= 15 and NAME_RE.match(apw)):
            raise Fail("the password: 6 to 15 letters, digits, - _ .", "account_pw")
        for b in bots():                                  # never a bot's account: they would log each other out
            if read_kv(bot_env(b)).get("HOST_ACCOUNT_ID", "").upper() == aid.upper():
                raise Fail("this account is bot %d's" % b, "doll_account_bot", b)
        for o in dolls():
            if o != n and read_kv(doll_env(o)).get("DOLL_ACCOUNT_ID", "").upper() == aid.upper():
                raise Fail("this account is doll %d's" % o, "doll_account_doll", o)
        kv["DOLL_ACCOUNT_ID"], kv["DOLL_ACCOUNT_PASSWORD"] = aid.upper(), apw.upper()
    if not kv.get("DOLL_ACCOUNT_ID") and not gate_on():
        raise Fail("a new doll needs its account", "doll_no_account", n)
    # (v141 beta 5) an accountless doll's name in the game ("" or DOLL_<n>: its own again); a doll with an account
    # plays under its account's name
    before = doll_name(n, kv) if not kv.get("DOLL_ACCOUNT_ID") else ""
    if "name" in d:
        nm = str(d.get("name") or "").strip()
        if nm.upper() == "DOLL_%d" % n:
            nm = ""
        if nm and kv.get("DOLL_ACCOUNT_ID"):
            raise Fail("a doll with an account plays under its account's name", "doll_name_account", n)
        if nm:
            check_doll_name(nm, n)
            kv["DOLL_NAME"] = nm
        else:
            kv.pop("DOLL_NAME", None)
    if kv.get("DOLL_ACCOUNT_ID"):
        kv.pop("DOLL_NAME", None)
    if "bot" in d:
        b = int(d["bot"])
        if b not in bots():
            raise Fail("no bot %d on this server" % b, "no_bot", b, ", ".join(map(str, bots())) or "-")
        kv["DOLL_BOT"] = str(b)
    if "difficulty" in d:                                 # (v150-host beta 16) "vdoll": its bot's virtual dolls' level
        kv["DOLL_DIFFICULTY"] = "vdoll" if d["difficulty"] == "vdoll" else str(level_arg(d["difficulty"], "difficulty"))
    if "adapt_min" in d or "adapt_max" in d:
        amin, amax = doll_bounds(kv)                      # (v141 beta 6) the bound not given kept; the lower first
        amin = level_arg(d["adapt_min"], "adapt_min") if "adapt_min" in d else amin
        amax = level_arg(d["adapt_max"], "adapt_max") if "adapt_max" in d else amax
        kv["DOLL_ADAPT_MIN"], kv["DOLL_ADAPT_MAX"] = str(min(amin, amax)), str(max(amin, amax))
    if "team" in d:
        if d["team"] not in DOLL_TEAMS:
            raise Fail("team: auto, red, blue or spectator", "usage", "team auto|red|blue|spectator")
        kv["DOLL_TEAM"] = d["team"]
    if "enabled" in d:
        kv["DOLL_ENABLED"] = "1" if d["enabled"] else "0"
    if "adapt" in d:
        kv["DOLL_ADAPT"] = "1" if d["adapt"] else "0"
    if "loadout" in d:
        lo = str(d["loadout"]).strip().lower()
        prim, _, sec = lo.partition(",")
        if prim not in DOLL_LOADOUTS or sec not in ("", "m1911", "mk22"):
            raise Fail("loadout: auto or a primary (scorpion xm16 ak47 m37 svd mosin)[,m1911|mk22]", "usage", "loadout")
        kv["DOLL_LOADOUT"] = lo
    if "aim" in d:                                        # (v150-host beta 18) direct or pad
        kv["DOLL_AIM"] = doll_aim_arg(d["aim"])
    kv.setdefault("DOLL_BOT", str(bots()[0] if bots() else 1))
    kv.setdefault("DOLL_TEAM", "auto"); kv.setdefault("DOLL_ENABLED", "1")
    # (v141 beta 6) the levels written as the doll takes them: 1 to 10 (or vdoll), else their defaults
    kv["DOLL_DIFFICULTY"] = "vdoll" if follows(kv) else str(doll_level(kv.get("DOLL_DIFFICULTY"), 3))
    amin, amax = doll_bounds(kv)
    kv["DOLL_ADAPT_MIN"], kv["DOLL_ADAPT_MAX"] = str(amin), str(amax)
    text = "# PLAYABLE DOLL %d (MGO1 Host.exe, mgo1host-agent doll-set)\n" % n
    for k in DOLL_KEYS:
        if k in kv:
            text += "%s=%s\n" % (k, kv[k])
    with dolls_lock():
        write_atomic(doll_env(n), text, 0o600)
        sync_counts()
    try:
        os.close(dir_fd(doll_state(n), make=True))
    except OSError:
        pass
    # live: the difficulty, the team and the weapons go to the running doll at once ((v141 beta 6) the live level and its
    # bounds too when given)
    difficulty_orders(n, kv, was[0])
    doll_order(n, "team %s" % kv["DOLL_TEAM"])
    if "adapt" in d and not follows(kv):                  # (one that follows the virtual dolls: off, its own kept for later)
        doll_order(n, "adapt %s" % ("on" if kv["DOLL_ADAPT"] == "1" else "off"))
    if "adapt_min" in d or "adapt_max" in d:
        doll_order(n, "adapt_min %s" % kv["DOLL_ADAPT_MIN"])
        doll_order(n, "adapt_max %s" % kv["DOLL_ADAPT_MAX"])
    if "loadout" in d:
        doll_order(n, "loadout %s" % kv["DOLL_LOADOUT"])
    if "aim" in d:
        doll_order(n, "aim %s" % kv["DOLL_AIM"])
    if "id" in d or ("enabled" in d and not d["enabled"]):
        systemctl("stop", "mgo1doll@%d" % n)               # a new account logs in again (the manager starts it)
    elif not kv.get("DOLL_ACCOUNT_ID") and doll_name(n, kv) != before:
        # renamed: a running doll leaves the game now (its order) and the manager starts it again, its log-in with the name
        code, state, _ = systemctl("is-active", "mgo1doll@%d" % n)
        if (state.strip() or ("active" if code == 0 else "")) in ("active", "activating"):
            doll_order(n, "leave")
        note("admin", do="doll-rename", doll=n, a=doll_name(n, kv))
    if (kv.get("DOLL_BOT"), kv.get("DOLL_ENABLED", "1")) != was[1:]:   # (its bots' other dolls that follow: their places)
        for b in {doll_bot(n)} | ({int(was[1])} if str(was[1] or "").isdigit() else set()):
            follow_sync(b)
    return {"ok": True, "doll": doll_summary(n)}


def cmd_doll_remove(args):
    n = doll_number(args)
    b = doll_bot(n)
    systemctl("stop", "mgo1doll@%d" % n)
    with dolls_lock():
        try:
            os.remove(doll_env(n))
        except OSError:
            pass
        sync_counts()                                     # (an accountless one: its bot's DOLL_COUNT one less)
    shutil.rmtree(doll_state(n), ignore_errors=True)
    follow_sync(b)
    return {"ok": True, "dolls": [doll_summary(x) for x in dolls()]}


class dolls_lock:
    """The lock mgo1doll-manager takes while it adds or removes dolls (a bot's DOLL_COUNT)."""
    def __enter__(self):
        import fcntl
        try:
            self.f = open(os.path.join(CONF, ".dolls.lock"), "a")
            fcntl.flock(self.f, fcntl.LOCK_EX)
        except OSError:
            self.f = None
        return self

    def __exit__(self, *a):
        if self.f:
            self.f.close()


def sync_counts():
    """Each bot's DOLL_COUNT, when set, kept to the accountless dolls it has after a doll set or removed by hand."""
    for b in bots():
        v = read_kv(bot_env(b)).get("DOLL_COUNT", "")
        if not v.isdigit():
            continue
        k = len([x for x in dolls() if doll_bot(x) == b and not read_kv(doll_env(x)).get("DOLL_ACCOUNT_ID")])
        if k != int(v):
            set_env_keys({"DOLL_COUNT": str(k)}, bot_env(b))


def set_doll_keys(n, keys):
    """Some keys of a doll's settings changed in its env file (kept for its next start)."""
    kv = read_kv(doll_env(n))
    if not kv:
        return
    kv.update(keys)
    text = "# PLAYABLE DOLL %d (MGO1 Host.exe, mgo1host-agent doll-set)\n" % n
    for k in DOLL_KEYS:
        if k in kv:
            text += "%s=%s\n" % (k, kv[k])
    write_atomic(doll_env(n), text, 0o600)


def doll_order(n, line):
    """An order in the doll's command file (appended; the doll reads and clears it)."""
    try:                                                   # (the doll's folder is the game's user's: never through a link)
        safe_write(os.path.join(doll_state(n), "command"), line + "\n", append=True, owner=True, make=True)
    except OSError as e:
        raise Fail("doll %d's command file cannot be written (%s)" % (n, e.strerror or e), "unsafe_file", n)


def cmd_doll_order(args):
    """doll-order <n> difficulty <1-10|vdoll> | team <auto|red|blue|spectator> | order <free|objective|hide|defend|follow>
    | order target <player name> | adapt <on|off> | adapt_min <1-10> | adapt_max <1-10> | aim <direct|pad> | leave"""
    n = doll_number(args)
    rest = args[1:]
    if not rest:
        raise Fail("an order", "usage", cmd_doll_order.__doc__.split("\n")[0])
    k = rest[0]
    was = follows(read_kv(doll_env(n)))
    if k == "difficulty" and len(rest) == 2 and (rest[1] in DOLL_LEVELS or rest[1] == "vdoll"):
        # (v150-host beta 16) vdoll: its bot's virtual dolls' level, the live level off (the number and `adapt off` sent)
        set_doll_keys(n, {"DOLL_DIFFICULTY": rest[1]})
        difficulty_orders(n, read_kv(doll_env(n)) or {"DOLL_DIFFICULTY": rest[1]}, was)
    elif k in ("adapt_min", "adapt_max") and len(rest) == 2 and rest[1] in DOLL_LEVELS:
        # (v141 beta 6) the live level's bounds: the other one kept, swapped when the wrong way round, both sent
        lo, hi = doll_bounds(read_kv(doll_env(n)))
        lo, hi = (int(rest[1]), hi) if k == "adapt_min" else (lo, int(rest[1]))
        lo, hi = min(lo, hi), max(lo, hi)
        doll_order(n, "adapt_min %d" % lo)
        doll_order(n, "adapt_max %d" % hi)
        set_doll_keys(n, {"DOLL_ADAPT_MIN": str(lo), "DOLL_ADAPT_MAX": str(hi)})
    elif k == "team" and len(rest) == 2 and rest[1] in DOLL_TEAMS:
        doll_order(n, "team %s" % rest[1])
        set_doll_keys(n, {"DOLL_TEAM": rest[1]})
    elif k == "order" and len(rest) >= 2 and rest[1] in DOLL_ORDERS:
        if rest[1] in ("target", "follow"):
            who = " ".join(rest[2:]).strip()
            if not PLAYER_RE.match(who):
                raise Fail("a player's name", "usage", "order %s <name>" % rest[1])
            doll_order(n, "order %s %s" % (rest[1], who))
        else:
            doll_order(n, "order %s" % rest[1])
        set_doll_keys(n, {"DOLL_ORDER": " ".join(rest[1:]).strip()})
    elif k == "adapt" and len(rest) == 2 and rest[1] in ("on", "off"):
        if not (was and rest[1] == "on"):                 # (one that follows the virtual dolls keeps it off: kept for later)
            doll_order(n, "adapt %s" % rest[1])
        set_doll_keys(n, {"DOLL_ADAPT": "1" if rest[1] == "on" else "0"})
    elif k == "aim" and len(rest) == 2:
        # (v150-host beta 18) direct: the doll turns its view at a virtual doll's speed; pad: through the stick (the default)
        a = doll_aim_arg(rest[1])
        doll_order(n, "aim %s" % a)
        set_doll_keys(n, {"DOLL_AIM": a})
    elif k == "leave":
        doll_order(n, "leave")
    else:
        raise Fail("unknown order " + " ".join(rest), "usage", cmd_doll_order.__doc__.split("\n")[0])
    return {"ok": True, "doll": doll_summary(n)}


def cmd_doll_all(args):
    """doll-all <bot> adapt <on|off> | difficulty <1-10|vdoll> | aim <direct|pad>: every doll of a bot's game, live and kept.
    (v150-host beta 16) difficulty vdoll: each one at the level of the bot's virtual dolls (its place in VDOLL_LEVEL), the live
    level off. (v150-host beta 18) aim: direct or pad (DOLL_AIM)."""
    usage = "doll-all <bot> adapt on|off | difficulty 1-10|vdoll | aim direct|pad"
    if len(args) != 3 or not args[0].isdigit() or not 1 <= int(args[0]) <= MAX_BOTS:
        raise Fail(usage, "usage", usage)
    b, k, v = int(args[0]), args[1], args[2]
    if k == "adapt" and v in ("on", "off"):
        keys = {"DOLL_ADAPT": "1" if v == "on" else "0"}
    elif k == "difficulty" and (v in DOLL_LEVELS or v == "vdoll"):
        keys = {"DOLL_DIFFICULTY": v}
    elif k == "aim":
        v = doll_aim_arg(v)
        keys = {"DOLL_AIM": v}
    else:
        raise Fail(usage, "usage", usage)
    for n in dolls():
        kv = read_kv(doll_env(n))
        if doll_bot(n) == b:
            was = follows(kv)
            set_doll_keys(n, keys)
            if k == "difficulty":
                difficulty_orders(n, dict(kv, **keys), was)
            elif k == "aim":
                doll_order(n, "aim %s" % v)
            elif not (was and v == "on"):                 # (one that follows the virtual dolls keeps its live level off)
                doll_order(n, "adapt %s" % v)
    return cmd_dolls()


VDOLL_MAX = 15
# their level (docs/VIRTUAL_DOLL.md 11): 1 to 10, or one a doll (the last for the rest), as mgo1host.sh checks it
VDOLL_LEVEL_RE = re.compile(r"^([1-9]|10)(,([1-9]|10)){0,14}$")


def vdoll_count_of(v):
    """A VDOLL_COUNT as mgo1host.sh takes it: 0 to 15, else 0."""
    v = str(v or "").strip()
    return min(VDOLL_MAX, int(v)) if v.isdigit() else 0


def vdoll_teams_of(v):
    """A VDOLL_TEAMS as mgo1host.sh gives it to the game: its small letters and commas, else auto."""
    return re.sub(r"[^a-z,]", "", str(v or "")) or "auto"


VDOLL_WEAPONS = ("auto", "ak47", "xm16e1", "scorpion", "m37", "svd")


def vdoll_weapons_of(v):
    """(v150-host beta 15) a VDOLL_WEAPONS as mgo1host.sh gives it to the game: its known words, else auto."""
    w = [x for x in re.sub(r"[^a-z0-9,]", "", str(v or "")).split(",") if x]
    return ",".join(x if x in VDOLL_WEAPONS else "auto" for x in w) or "auto"


def vdoll_level_of(v):
    """A VDOLL_LEVEL as mgo1host.sh gives it to the game: valid, else the game's own 5."""
    v = re.sub(r"\s", "", str(v or ""))
    return v if VDOLL_LEVEL_RE.match(v) else "5"


VDOLL_CONTROLS = ("direct", "player")


def vdoll_controls_of(v):
    """(v150-host beta 18) a VDOLL_CONTROLS as mgo1host.sh takes it: player, else direct (the default, as before)."""
    return "player" if re.sub(r"[\s\"']", "", str(v or "")).lower() == "player" else "direct"


def vdoll_bound_of(v, default):
    """(v150-host beta 19) a VDOLL_ADAPT_MIN / VDOLL_ADAPT_MAX as mgo1host.sh takes it: 1 to 10 (leading zeros read as
    decimal), else its default."""
    v = re.sub(r"[\s\"']", "", str(v or ""))
    return int(v) if re.match(r"^[0-9]{1,3}$", v) and 1 <= int(v) <= 10 else default


def vdoll_adapt_of(kv):
    """(v150-host beta 19) The virtual dolls' live level as mgo1host.sh gives it to the game from these keys (bot<N>.env, or
    the running game's run/vdolls.env): (on, lowest, highest); on only with VDOLL_ADAPT=1, the bounds 1 and 10 by default,
    swapped when the wrong way round."""
    on = re.sub(r"[\s\"']", "", str(kv.get("VDOLL_ADAPT") or "")) == "1"
    lo, hi = vdoll_bound_of(kv.get("VDOLL_ADAPT_MIN"), 1), vdoll_bound_of(kv.get("VDOLL_ADAPT_MAX"), 10)
    return on, min(lo, hi), max(lo, hi)


def vdoll_adapt_arg(v):
    """vdoll-set's "adapt": true or false (also 1 / 0, "on" / "off", "true" / "false", "1" / "0"; null or "": off, the
    default); else refused."""
    if v in (None, ""):
        return False
    if isinstance(v, bool):
        return v
    if isinstance(v, int) and v in (0, 1):
        return bool(v)
    if isinstance(v, str) and v.strip().lower() in ("1", "on", "true", "0", "off", "false"):
        return v.strip().lower() in ("1", "on", "true")
    raise Fail("adapt: true or false", "vdoll_adapt", json.dumps(v) if not isinstance(v, str) else v)


def vdoll_bound_arg(key, v):
    """vdoll-set's "adapt_min" / "adapt_max": 1 to 10 (a number or its digits); else refused."""
    if isinstance(v, str) and v.strip() in DOLL_LEVELS:
        v = int(v)
    if isinstance(v, bool) or not isinstance(v, int) or not 1 <= v <= 10:
        raise Fail("%s: 1 to 10" % key, "vdoll_adapt_level", key, json.dumps(v) if not isinstance(v, str) else v)
    return v


def vdoll_live_lines(text, count=None, adapt=None):
    """(v150-host beta 19) The text of run/vdolls.live: its first line the count wanted (a game of beta 18 or older reads only
    that number), then `adapt 0|1`, `adapt_min <n>`, `adapt_max <n>` when the live level is set (the game of beta 19 reads
    them every 2 s). count None: the file's own count kept; adapt (on, lo, hi) None: the file's own lines after the count
    kept."""
    lines = (text or "").split("\n")
    first, rest = lines[0].strip(), [x for x in lines[1:] if x.strip()]
    if count is not None:
        first = str(count)
    if adapt is not None:
        rest = ["adapt %d" % (1 if adapt[0] else 0), "adapt_min %d" % adapt[1], "adapt_max %d" % adapt[2]]
    return "".join("%s\n" % x for x in [first] + rest)


LEVELS_NOW_RE = re.compile(r" vdoll: levels now ((?:[0-9]+(?:\.[0-9]+)?[ ]+)+)\(set ([0-9,]+)\)")


def vdoll_levels_now(b):
    """(v150-host beta 19) The levels now of the virtual dolls in the game (`in_game` in the status), as the bot's game last
    said them in the day's log (`vdoll: levels now 7.25 8.00 (set 10,10)`, at least every 60 s while the live level is on):
    (levels now, the levels set they move from), both in the dolls' numbers' order; None when the game has not said them
    since its last start (the launcher's start line) or turned the live level off since (`vdoll: level: fixed`), or the
    day has no log. The file's end read backwards, 2 MB at most, never through a link."""
    path = os.path.join(LOG_ROOT, "bot%d" % b, time.strftime("%Y-%m-%d", time.gmtime()) + ".log")
    start = ("mgo1host: bot %d, UDP port " % b).encode()
    try:
        d, name = os.path.split(os.path.abspath(path))
        dfd = dir_fd(d)
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
        finally:
            os.close(dfd)
        with os.fdopen(fd, "rb") as f:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                return None
            end = f.seek(0, 2)
            tail, at = b"", end
            while at > 0 and end - at < (2 << 20):
                step = min(256 << 10, at)
                at -= step
                f.seek(at)
                tail = f.read(step) + tail
                lines = tail.split(b"\n")
                if at > 0:
                    lines = lines[1:]                          # (a line cut by the block's start: read with the next block)
                for line in reversed(lines):
                    if start in line or b" vdoll: level: fixed" in line:
                        return None
                    if b" vdoll: levels now " in line:
                        m = LEVELS_NOW_RE.search(line.decode("utf-8", "replace"))
                        if not m:
                            return None
                        now, set_ = [round(float(x), 2) for x in m.group(1).split()], [int(x) for x in m.group(2).split(",") if x]
                        return now, set_ if len(set_) == len(now) else None
    except (OSError, ValueError):
        return None
    return None


def vdoll_level_arg(v):
    """vdoll-set's "level": 1 to 10, "3,5,7" or [3, 5, 7] (one a doll, the last for the rest; 15 at most), as bot<N>.env
    keeps it ("3,5,7"); else refused."""
    items = v if isinstance(v, list) else [v] if isinstance(v, int) else str(v).split(",") if isinstance(v, str) else None
    out = []
    for x in items if items is not None else [None]:
        if isinstance(x, str) and x.strip() in DOLL_LEVELS:
            x = int(x)
        if isinstance(x, bool) or not isinstance(x, int) or not 1 <= x <= 10:
            out = None
            break
        out.append(x)
    if not out or len(out) > VDOLL_MAX:
        raise Fail("level: 1 to 10, or one a doll (3,5,7)", "vdoll_level", json.dumps(v) if not isinstance(v, str) else v)
    return ",".join(str(x) for x in out)


def vdoll_names_file(path):
    """A names file as the game reads it: a name a line, the empty ones skipped, 15 characters at most."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return [x.strip()[:15] for x in f.read().splitlines() if x.strip()][:VDOLL_MAX]
    except OSError:
        return []


def vdoll_each(count, teams, level, names, weapons="auto"):
    """Each virtual doll's team, level, name and weapon as the game gives them (a list's last value for the rest, VDOLL<n>
    unnamed)."""
    t, lv, w = teams.split(","), level.split(","), weapons.split(",")
    return [(t[min(i, len(t) - 1)] if t[min(i, len(t) - 1)] in ("red", "blue") else "auto", int(lv[min(i, len(lv) - 1)]),
             names[i] if i < len(names) else "VDOLL%d" % (i + 1), w[min(i, len(w) - 1)]) for i in range(count)]


def bot_vdolls(b):
    """A bot's virtual dolls: its settings (count, teams, level, names), those its running game was given (mgo1host.sh's
    run/vdolls.env, run/vdolls.names; None before a start of this version) and, from its status, those in its game now."""
    kv = read_kv(bot_env(b))
    count, teams, level = vdoll_count_of(kv.get("VDOLL_COUNT")), vdoll_teams_of(kv.get("VDOLL_TEAMS")), vdoll_level_of(kv.get("VDOLL_LEVEL"))
    weapons = vdoll_weapons_of(kv.get("VDOLL_WEAPONS"))
    controls = vdoll_controls_of(kv.get("VDOLL_CONTROLS"))   # (v150-host beta 18)
    adapt, amin, amax = vdoll_adapt_of(kv)                    # (v150-host beta 19) the live level
    names = vdoll_names_file(os.path.join(CONF, "bot%d.vdolls" % b))
    run = os.path.join(bot_state(b), "run")
    st, age = {}, None
    try:
        with open(os.path.join(run, "status.json")) as f:
            st = json.load(f)
        age = int(time.time() - os.path.getmtime(os.path.join(run, "status.json")))
    except (OSError, ValueError):
        st = {}
    if not isinstance(st, dict):
        st = {}
    live = st.get("vdolls") if isinstance(st.get("vdolls"), list) else []
    applied, pending = None, None
    if os.path.isfile(os.path.join(run, "vdolls.env")):
        akv = read_kv(os.path.join(run, "vdolls.env"))
        applied = {"count": vdoll_count_of(akv.get("VDOLL_COUNT")), "teams": vdoll_teams_of(akv.get("VDOLL_TEAMS")),
                   "level": vdoll_level_of(akv.get("VDOLL_LEVEL")), "names": vdoll_names_file(os.path.join(run, "vdolls.names"))}
        if "VDOLL_WEAPONS" in akv:                             # (beta 15: a game started by this version)
            applied["weapons"] = vdoll_weapons_of(akv.get("VDOLL_WEAPONS"))
        if "VDOLL_CONTROLS" in akv:                            # (beta 18: a game started by this version; before it, direct)
            applied["controls"] = vdoll_controls_of(akv.get("VDOLL_CONTROLS"))
        if "VDOLL_ADAPT" in akv:                               # (beta 19: as the game has it now, vdoll-set changes it live)
            applied["adapt"], applied["adapt_min"], applied["adapt_max"] = vdoll_adapt_of(akv)
        pending = vdoll_each(count, teams, level, names, weapons) != vdoll_each(applied["count"], applied["teams"], applied["level"],
                                                                               applied["names"], applied.get("weapons", weapons)) \
            or (count > 0 and controls != applied.get("controls", "direct"))
    res = {"bot": b, "count": count, "teams": teams, "level": level, "names": names, "weapons": weapons, "controls": controls,
           "adapt": adapt, "adapt_min": amin, "adapt_max": amax,
           "most": max(0, game_max_players(b) - 2), "set_in_game": st.get("vdolls_set"), "in_game": st.get("players_vdolls", 0), "live": live,
           "status_age": age, "applied": applied, "pending": pending}
    # (v150-host beta 19) each virtual doll's level now, when its running game has the live level on and has said them
    # since its start (its last `vdoll: levels now ...` line); absent otherwise
    if applied is not None and applied.get("adapt"):
        now = vdoll_levels_now(b)
        if now is not None:
            res["levels_now"] = now[0]
            if now[1] is not None:
                res["levels_now_set"] = now[1]
    return res


def cmd_vdolls():
    # (v150-host beta 18) this server takes vdoll-set's "controls": MGO1 Host shows CONTROLS only when it sees this;
    # (beta 19) and "adapt", "adapt_min", "adapt_max": MGO1 Host offers the LIVE LEVEL only when it sees "vdoll_adapt"
    return {"ok": True, "bots": [bot_vdolls(b) for b in bots()], "vdoll_controls": True, "vdoll_adapt": True}


def cmd_vdoll_set(args):
    """vdoll-set <bot> [--restart]: the bot's virtual dolls from {"count", "teams", "level", "names"} on stdin (a key left out
    kept)."""
    global BOT
    restart = "--restart" in args
    args = [a for a in args if a != "--restart"]
    if len(args) != 1 or not args[0].isdigit():
        raise Fail("vdoll-set <bot> [--restart]", "usage", "vdoll-set <bot> [--restart]")
    b = int(args[0])
    if b not in bots():
        raise Fail("no bot %d on this server" % b, "no_bot", b, ", ".join(map(str, bots())) or "-")
    BOT = b
    try:
        d = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        raise Fail("the settings are not JSON", "bad_json")
    if not isinstance(d, dict):
        raise Fail("the settings are not a JSON object", "bad_json")
    keys = {}
    if "count" in d:
        most = min(VDOLL_MAX, max(0, game_max_players(b) - 2))  # (the host's entry, a seat kept for a real player)
        n = d["count"]
        if isinstance(n, str) and n.strip().isdigit():
            n = int(n)
        if isinstance(n, bool) or not isinstance(n, int) or n < 0 or n > most:
            raise Fail("bot %d: %d virtual dolls at most (its players less the host and a kept seat)" % (b, most), "vdoll_count", b, most)
        keys["VDOLL_COUNT"] = str(n)
    if "teams" in d:
        t = str(d["teams"] or "auto").strip().lower().replace(" ", "")
        if not t or any(x not in ("red", "blue", "auto") for x in t.split(",")) or len(t.split(",")) > VDOLL_MAX:
            raise Fail("teams: red, blue or auto, comma separated", "vdoll_teams", t)
        keys["VDOLL_TEAMS"] = t
    if "level" in d:
        keys["VDOLL_LEVEL"] = vdoll_level_arg(5 if d["level"] in (None, "") else d["level"])
    if "weapons" in d:                                         # (beta 15) auto, ak47, xm16e1, scorpion, m37, svd: one a doll
        w = str(d["weapons"] or "auto").strip().lower().replace(" ", "").replace("-", "")
        if not w or any(x not in VDOLL_WEAPONS for x in w.split(",")) or len(w.split(",")) > VDOLL_MAX:
            raise Fail("weapons: auto, ak47, xm16e1, scorpion, m37 or svd, comma separated", "vdoll_weapons", w)
        keys["VDOLL_WEAPONS"] = w
    if "controls" in d:                                        # (beta 18) player or direct (null or "": direct, the default)
        c = d["controls"]
        c = "direct" if c in (None, "") else c.strip().lower() if isinstance(c, str) else c
        if c not in VDOLL_CONTROLS:
            raise Fail("controls: player or direct", "vdoll_controls", json.dumps(d["controls"]) if not isinstance(d["controls"], str) else d["controls"])
        keys["VDOLL_CONTROLS"] = c
    # (beta 19) the live level: "adapt" true or false, its bounds "adapt_min", "adapt_max" 1 to 10 (the bound not given kept,
    # the lower first); the running game takes them at once (run/vdolls.live), its next games from bot<N>.env
    if "adapt" in d:
        keys["VDOLL_ADAPT"] = "1" if vdoll_adapt_arg(d["adapt"]) else "0"
    if "adapt_min" in d or "adapt_max" in d:
        _, amin, amax = vdoll_adapt_of(read_kv(bot_env(b)))
        amin = vdoll_bound_arg("adapt_min", d["adapt_min"]) if "adapt_min" in d else amin
        amax = vdoll_bound_arg("adapt_max", d["adapt_max"]) if "adapt_max" in d else amax
        keys["VDOLL_ADAPT_MIN"], keys["VDOLL_ADAPT_MAX"] = str(min(amin, amax)), str(max(amin, amax))
    names = None
    if "names" in d:
        names = d["names"] or []
        if not isinstance(names, list) or len(names) > VDOLL_MAX:
            raise Fail("names: a list of 15 names at most", "vdoll_names")
        seen = set()
        for x in names:
            x = str(x)
            if not DOLL_NAME_RE.match(x) or "  " in x or DOLL_DEFAULT_RE.match(x):
                raise Fail("a virtual doll's name: 3 to 15 letters, digits, spaces and . _ - ! ? + *", "doll_name", x)
            if x.upper() in seen:
                raise Fail("two virtual dolls of the same name", "vdoll_name_taken", x)
            seen.add(x.upper())
    # (every key checked before anything is written)
    if names is not None:
        write_atomic(os.path.join(CONF, "bot%d.vdolls" % b), "".join("%s\n" % str(x) for x in names), 0o644)
    if keys:
        set_env_keys(keys, bot_env(b))
    if "VDOLL_LEVEL" in keys:                              # (v150-host beta 16) its playable dolls that follow it: live
        follow_sync(b)                                     # ((beta 19) the level SET, never the live level's level now)
    adapt_live = None
    if any(k in keys for k in ("VDOLL_ADAPT", "VDOLL_ADAPT_MIN", "VDOLL_ADAPT_MAX")) and not restart:
        adapt_live = vdoll_adapt_live(b)
    note("admin", do="vdoll-set", bot=b, count=keys.get("VDOLL_COUNT"), teams=keys.get("VDOLL_TEAMS"), level=keys.get("VDOLL_LEVEL"), weapons=keys.get("VDOLL_WEAPONS"),
         controls=keys.get("VDOLL_CONTROLS"), adapt=keys.get("VDOLL_ADAPT"), adapt_min=keys.get("VDOLL_ADAPT_MIN"), adapt_max=keys.get("VDOLL_ADAPT_MAX"),
         restart=restart)
    res = {"ok": True, "vdolls": bot_vdolls(b), "takes_effect": "now" if restart else "next game", "vdoll_controls": True, "vdoll_adapt": True}
    if adapt_live is not None:                             # (beta 19) the live level's keys: "now" when the running game took them
        res["adapt_takes_effect"] = "now" if adapt_live else "next game"
    if restart:
        res["restart"] = cmd_restart(noted=False)
    return res


def vdoll_adapt_live(b):
    """(v150-host beta 19) The bot's live level as bot<N>.env now has it told to its running game: the lines after the count
    in run/vdolls.live (the game reads them within 2 s) and the run's vdolls.env (what the game has: vdolls' "applied").
    True when the running game was started by a launcher that gives the live file; False: none (its next start reads
    bot<N>.env)."""
    run = os.path.join(bot_state(b), "run")
    live = os.path.join(run, "vdolls.live")
    if not os.path.isfile(live):
        return False
    adapt = vdoll_adapt_of(read_kv(bot_env(b)))
    write_atomic(live, vdoll_live_lines(safe_read(live, 4096), adapt=adapt), 0o644)
    if os.path.isfile(os.path.join(run, "vdolls.env")):
        akv = read_kv(os.path.join(run, "vdolls.env"))
        akv["VDOLL_ADAPT"], akv["VDOLL_ADAPT_MIN"], akv["VDOLL_ADAPT_MAX"] = "1" if adapt[0] else "0", str(adapt[1]), str(adapt[2])
        write_atomic(os.path.join(run, "vdolls.env"), "".join("%s=%s\n" % kv for kv in akv.items()), 0o644)
    return True


def cmd_vdoll_count(args):
    """vdoll-count <bot> <n>: the bot's virtual dolls wanted now (its running game reads run/vdolls.live every 2 s) and in
    its next games (VDOLL_COUNT)."""
    global BOT
    if len(args) != 2 or not args[0].isdigit() or not args[1].isdigit():
        raise Fail("vdoll-count <bot> <n>", "usage", "vdoll-count <bot> <n>")
    b, n = int(args[0]), int(args[1])
    if b not in bots():
        raise Fail("no bot %d on this server" % b, "no_bot", b, ", ".join(map(str, bots())) or "-")
    BOT = b
    most = min(VDOLL_MAX, max(0, game_max_players(b) - 2))
    if n > most:
        raise Fail("bot %d: %d virtual dolls at most (its players less the host and a kept seat)" % (b, most), "vdoll_count", b, most)
    set_env_keys({"VDOLL_COUNT": str(n)}, bot_env(b))
    run = os.path.join(bot_state(b), "run")
    live = False
    if os.path.isfile(os.path.join(run, "vdolls.live")):  # (a game started by this version: it takes the count at once)
        # ((beta 19) the live level's lines after the count kept)
        write_atomic(os.path.join(run, "vdolls.live"), vdoll_live_lines(safe_read(os.path.join(run, "vdolls.live"), 4096), count=n), 0o644)
        if os.path.isfile(os.path.join(run, "vdolls.env")):
            akv = read_kv(os.path.join(run, "vdolls.env"))
            akv["VDOLL_COUNT"] = str(n)
            write_atomic(os.path.join(run, "vdolls.env"), "".join("%s=%s\n" % kv for kv in akv.items()), 0o644)
        live = True
    note("admin", do="vdoll-count", bot=b, count=n, live=live)
    return {"ok": True, "vdolls": bot_vdolls(b), "takes_effect": "now" if live else "next game"}


