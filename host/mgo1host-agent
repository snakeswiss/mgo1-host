    return {"ok": True, "schedule": args[0]}


def cmd_scheduled_restart():
    """At the scheduled time: every running bot restarts once no one plays in its game (at most an hour later)."""
    global BOT
    left = [b for b in bots() if service_state(b)[0] == "active"]
    done = []
    for _ in range(121):
        for b in list(left):
            BOT = b
            host, age = read_status()
            if not [p for p in (host or {}).get("players", []) if not p.get("host")] or _ == 120:
                note("admin", do="daily-restart")
                cmd_restart(noted=False)
                left.remove(b)
                done.append(b)
        if not left:
            break
        time.sleep(30)
    return {"ok": True, "restarted": done}


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def build_state():
    """(build 1.00, srvbuild) the host built on this server from MGO1 Host's public package (install.sh, host/build_server.sh,
    docs/DEDICATED_HOST.md section 27): its tree kept for updates, what the last build made and how long it took"""
    tree = os.path.join(HOME_DIR, "build")
    st = {"tree": os.path.isdir(os.path.join(tree, "src")), "built": False}
    kv = read_kv(os.path.join(tree, "built.txt"))
    if kv.get("exe"):
        try:
            secs = int(kv.get("seconds") or 0)
