        systemctl("disable", "--now", "mgo1host-restart.timer")
        return {"ok": True, "schedule": "off"}
    agent = os.path.abspath(sys.argv[0])
    write_atomic(unit, "[Unit]\nDescription=MGO1 dedicated host: the daily restart of every bot (once its game is empty)\n\n"
