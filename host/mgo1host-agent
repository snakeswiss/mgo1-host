        return int(read_kv(doll_env(n)).get("DOLL_BOT", "1"))
    except ValueError:
        return 1


def usable_cores():
    """(v141 beta 12) The cores the games may use: three quarters of them, less the share the VPS's machine has taken since
    the server started (/proc/stat's steal), as mgo1doll-manager counts them."""
    steal = 0.0
    try:
        with open("/proc/stat") as f:
            v = [int(x) for x in f.readline().split()[1:]]
        if len(v) > 7 and sum(v[:8]):
            steal = min(0.8, v[7] / sum(v[:8]))
    except (OSError, ValueError):
        pass
    return (os.cpu_count() or 1) * (1.0 - steal) * 0.75


def doll_capacity():
    """The dolls this server can run at once besides its bots: a doll is a whole game too. (v141 beta 12) measured 0.32 of
    a core at the game's full pace and 140 MB, counted 0.4 and 250 MB; a bot 0.35 and 350 MB; the usable cores
    (mgo1doll-manager keeps to it, its pace guard takes the dolls a slower server cannot keep at the game's pace)."""
    mem = 0
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("MemTotal:"):
                mem = int(line.split()[1]) // 1024
    except OSError:
        pass
    n = len(bots())
    cores, left = usable_cores() - 0.35 * n, mem - 400 - 350 * n     # what the bots leave
    return max(0, min(MAX_DOLLS, int(cores / 0.4), int(left / 250)))


