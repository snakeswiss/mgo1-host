# ---- no log-in data in what is shown or logged -------------------------------------------------
def secrets(n=None):
    """The log-in data to mask: [(text in capitals, whole word only)] for bot n, or every bot."""
    res = []
    for b in ([n] if n else bots()):
        kv = read_kv(bot_env(b))
        for k, word in (("HOST_ACCOUNT_ID", True), ("HOST_ACCOUNT_PASSWORD", False)):
            v = kv.get(k, "").strip().upper()
            if len(v) >= 3:
                res.append((v, word))
        gpw = read_kv(bot_game(b)).get("password", "").strip().upper()
        if gpw:
            res.append((gpw, True))                        # the game's password lock
    if not n:                                              # the PLAYABLE DOLLs' accounts too
        for d in dolls():
            kv = read_kv(doll_env(d))
            for k, word in (("DOLL_ACCOUNT_ID", True), ("DOLL_ACCOUNT_PASSWORD", False)):
                v = kv.get(k, "").strip().upper()
                if len(v) >= 3:
                    res.append((v, word))
    return sorted(set(res), key=lambda x: -len(x[0]))


def redact(text, sec):
    """text with each secret masked (***); an account ID or a game password as a whole word only."""
    if not text or not sec:
        return text
    up = text.upper()
    for v, word in sec:
        if v not in up:
            continue
        out, i = [], 0
        while True:
            j = up.find(v, i)
            if j < 0:
                break
            before = up[j - 1] if j else ""
            after = up[j + len(v)] if j + len(v) < len(up) else ""
            if word and (re.match(r"[A-Z0-9_]", before) or re.match(r"[A-Z0-9_]", after)):
                out.append(text[i:j + len(v)])
            else:
                out.append(text[i:j] + "***")
            i = j + len(v)
        out.append(text[i:])
        text = "".join(out)
        up = text.upper()
    return text


def redact_event(e, sec):
    """An event of the Game Report with no log-in data: the old owner's lines lose theirs too."""
    if e.get("k") == "admin" and e.get("do") == "account":
        e.pop("a", None)
    if e.get("k") == "admin" and e.get("do") == "servers":
        e.pop("gate", None)
        e.pop("stun", None)
    for k, v in list(e.items()):
        if isinstance(v, str):
            e[k] = redact(v, sec)
        elif isinstance(v, list):
            e[k] = [redact_event(x, sec) if isinstance(x, dict) else redact(x, sec) if isinstance(x, str) else x for x in v]
    return e


def cmd_redact():
    """A filter: every line of stdin to stdout with the log-in data of every bot masked."""
    sec = secrets()
    for line in sys.stdin:
        sys.stdout.write(redact(line, sec))
        sys.stdout.flush()
    return None


# ---- the Game Report ------------------------------------------------------------------------------
def events_dir(n=None):
    return os.path.join(bot_state(n), "events")


def note(kind, **fields):
    """An event of this program's own (the owner's actions), in <day>.admin.jsonl beside the game's."""
    d = events_dir()
    try:
        t = int(time.time() * 1000)
        line = json.dumps(dict({"t": t, "k": kind}, **fields), separators=(",", ":"))
        safe_write(os.path.join(d, time.strftime("%Y-%m-%d", time.gmtime(t / 1000)) + ".admin.jsonl"), line + "\n", append=True, make=True)
    except OSError:
        pass


def events_prune(n=None):
    """The days older than KEEP_DAYS go."""
    limit = time.strftime("%Y-%m-%d", time.gmtime(time.time() - KEEP_DAYS * 86400))
    for p in glob.glob(os.path.join(events_dir(n), "*.jsonl")):
        if os.path.basename(p)[:10] < limit:
            try:
                os.remove(p)
            except OSError:
                pass


EVENT_T = re.compile(r'\{"t":(\d+)')


def events_read(since, limit):
    """The events with t >= since, oldest first, at most limit (and whether more remain). (v141 beta 4) a day at a time
    (its game lines and the owner's merged), the reading stopped once past the limit; a line older than since skipped
    from its "t" without decoding it."""
    day = time.strftime("%Y-%m-%d", time.gmtime(max(since, 0) / 1000))
    by_day = {}
    for p in glob.glob(os.path.join(events_dir(), "*.jsonl")):
        if os.path.basename(p)[:10] >= day:
            by_day.setdefault(os.path.basename(p)[:10], []).append(p)
    evs, more = [], False
    for d in sorted(by_day):
        day_evs = []
        for p in sorted(by_day[d]):
            try:
                with open(p, errors="replace") as f:
                    for line in f:
                        m = EVENT_T.match(line)
                        if m and int(m.group(1)) < since:
                            continue
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            e = json.loads(line)
                        except ValueError:
                            continue
                        if isinstance(e, dict) and isinstance(e.get("t"), int) and e["t"] >= since:
                            day_evs.append(e)
            except OSError:
                continue
        day_evs.sort(key=lambda e: e["t"])                 # the game's lines and the owner's, merged
        evs.extend(day_evs)
        if len(evs) > limit:
            more = True
            break
    sec = secrets(BOT)
    return [redact_event(e, sec) for e in evs[:limit]], more


class EventTail:
    """The Game Report's new lines as they are written: each file of the bot's events read on from
    where it was last read (the host's day file and the owner's, the next days as they come)."""

    def __init__(self):
        self.pos = {}
        for p in glob.glob(os.path.join(events_dir(), "*.jsonl")):
            try:
                self.pos[p] = os.path.getsize(p)
            except OSError:
                pass

    def read(self):
        evs = []
        today = time.strftime("%Y-%m-%d", time.gmtime(time.time() - 3600))
        for p in sorted(glob.glob(os.path.join(events_dir(), "*.jsonl"))):
            if os.path.basename(p)[:10] < today and p in self.pos:
                continue                                   # a past day: nothing is written there any more
            try:
                with open(p, "rb") as f:
                    f.seek(self.pos.get(p, 0))
                    data = f.read()
            except OSError:
                continue
            end = data.rfind(b"\n") + 1                   # whole lines only
            self.pos[p] = self.pos.get(p, 0) + end
            for line in data[:end].decode(errors="replace").splitlines():
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if isinstance(e, dict) and isinstance(e.get("t"), int):
                    evs.append(e)
        evs.sort(key=lambda e: e["t"])
        sec = secrets(BOT) if evs else []
        return [redact_event(e, sec) for e in evs]


def cmd_events(args):
    need_bot()
    since, limit = 0, 2000
    if "--since" in args:
        since = int(args[args.index("--since") + 1])
    if "--limit" in args:
        limit = max(1, min(int(args[args.index("--limit") + 1]), 10000))
    events_prune()
    evs, more = events_read(since, limit)
    return {"ok": True, "bot": BOT, "events": evs, "more": more, "now": int(time.time() * 1000)}


# ---- the host's state -----------------------------------------------------------------------------
_STATE_CACHE = {}                                  # ("a" | "e", unit) -> (time, answer)


def service_state(n=None):
    """(v141 beta 4) systemctl's answers kept 3 s: the watch asked both every second and every bot's every 2 s, each a
    process and a call to systemd."""
    unit, now = service(n), time.time()
    a = _STATE_CACHE.get(("a", unit))
    if not a or now - a[0] > 3:
        rc, so, _ = systemctl("is-active", unit)
        a = (now, so.strip() or ("unknown" if rc == 127 else "inactive"))
        _STATE_CACHE[("a", unit)] = a
    e = _STATE_CACHE.get(("e", unit))
    if not e or now - e[0] > 3:
        rc, so, _ = systemctl("is-enabled", unit)
        e = (now, so.strip() == "enabled")
        _STATE_CACHE[("e", unit)] = e
    return a[1], e[1]


def host_process(n=None):
    """The bot's game process (Wine runs mgo1host.exe in the bot's run folder): pid, CPU ticks, memory, start."""
    run = os.path.join(bot_state(n), "run")
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read()
            if b"mgo1host.exe" not in cmd or b"mgo1host-agent" in cmd or b"wine" in cmd.split(b"\0")[0]:
                continue
            if os.readlink(f"/proc/{pid}/cwd") != run:
                continue
            with open(f"/proc/{pid}/stat") as f:
                st = f.read().rsplit(")", 1)[1].split()
            return {"pid": int(pid), "ticks": int(st[11]) + int(st[12]), "rss": int(st[21]) * os.sysconf("SC_PAGE_SIZE"),
                    "start": int(st[19])}
        except (OSError, IndexError, ValueError):
            continue
    return None


def uptime_s():
    try:
        with open("/proc/uptime") as f:
            return float(f.read().split()[0])
    except OSError:
        return 0.0


def sys_now():
    info = {}
    try:
        info["load"] = [round(x, 2) for x in os.getloadavg()]
    except OSError:
        info["load"] = []
    mem = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                mem[k] = int(v.split()[0]) // 1024
    except OSError:
        pass
    info["mem_total_mb"] = mem.get("MemTotal", 0)
    info["mem_avail_mb"] = mem.get("MemAvailable", 0)
    du = shutil.disk_usage(STATE_ROOT if os.path.isdir(STATE_ROOT) else "/")
    info["disk_free_gb"] = round(du.free / 2**30, 1)
    info["uptime_s"] = int(uptime_s())
    info["cores"] = os.cpu_count() or 1
    # (v141 beta 12) about 0.35 of a core (a quarter of the cores kept free, the VPS's steal taken off) and 350 MB a bot
    info["bots_max"] = max(1, min(MAX_BOTS, int(usable_cores() / 0.35), int((info["mem_total_mb"] - 400) / 350)))
    return info


def read_status(n=None):
    path = os.path.join(bot_state(n), "run", "status.json")
    try:
        st = os.stat(path)
        with open(path) as f:
            return json.load(f), time.time() - st.st_mtime
    except (OSError, ValueError):
        return None, None


def schedule_now():
    path = os.path.join(TIMER_DIR, "mgo1host-restart.timer")
    try:
        with open(path) as f:
            m = re.search(r"OnCalendar=\*-\*-\* (\d\d):(\d\d)", f.read())
    except OSError:
        return "off"
    if not m:
        return "off"
    rc, so, _ = systemctl("is-enabled", "mgo1host-restart.timer")
    return f"{m.group(1)}:{m.group(2)}" if so.strip() == "enabled" else "off"


def online_of(svc, host, age, proc):
    """online / starting / offline, and why."""
    proc_up = uptime_s() - proc["start"] / os.sysconf("SC_CLK_TCK") if proc else None
    if svc not in ("active", "activating", "reloading"):
        return "offline", "service " + svc
    if host is None or age is None or proc is None or age > proc_up + 1:
        return "starting", "no status yet"                   # no game process, or its status is the last one's
    if age > 15:
        return "offline", "status not updated for %d s" % age
    if host.get("state") == "hosting" and host.get("lobby") == 1:
        return "online", ""
    if host.get("state") == "hosting":
        return "offline", "lobby connection closed"
    if host.get("state") == "lost":
        return "offline", "game ended (a new one is being created)"
    if host.get("error"):
        return "offline", "log-in error: " + str(host["error"])[:120]    # the game's own message on the screen
    return "starting", "logging in / creating the game"


def lobby_grace(n=None):
    """(v141 beta 6) The seconds a bot's game waits for a new lobby connection before it ends with 6: HOST_LOBBY_GRACE
    (server.env, its bot<N>.env over it, as systemd reads them), 10 by default, 5 to 60 as the game takes it."""
    kv = read_kv(SERVER_ENV)
    kv.update(read_kv(bot_env(n)))
    m = re.match(r"\s*([+-]?\d+)", kv.get("HOST_LOBBY_GRACE", "") or "10")
    return max(5, min(60, int(m.group(1)) if m else 0))


def lobby_restart_in(svc, host, age, proc):
    """(v141 beta 6) The seconds left before the game ends with 6 (its lobby connection closed): the grace less the host's
    lobby_lost_for; None when the lobby is not lost or the status is not the running game's."""
    lost = (host or {}).get("lobby_lost_for")
    if not isinstance(lost, (int, float)) or isinstance(lost, bool) or lost < 0:
        return None
    if svc not in ("active", "activating", "reloading") or age is None or proc is None or age > 15 \
            or age > uptime_s() - proc["start"] / os.sysconf("SC_CLK_TCK") + 1:
        return None
    return max(0, lobby_grace() - int(lost))


def player_kinds(players):
    """(v141 beta 6) (real players, dolls) among a game's players (the host left out): each player's "kind" when the host
    gives it, else the server's dolls' names (the doll manager's dolls.names, as the manager does)."""
    if not players:
        return 0, 0
    if all("kind" in p for p in players):
        return len([p for p in players if p.get("kind") == "real"]), len([p for p in players if p.get("kind") == "doll"])
    try:
        with open(os.path.join(STATE_ROOT, "dolls.names"), encoding="utf-8", errors="replace") as f:
            names = {line.strip().upper() for line in f if line.strip()}
    except OSError:
        names = set()
    k = len([p for p in players if str(p.get("name", "")).upper() in names])
    return len(players) - k, k


def bot_summary(n):
    svc, enabled = service_state(n)
    host, age = read_status(n)
    proc = host_process(n)
    online, reason = online_of(svc, host, age, proc)
    live = online == "online"
    game = (host or {}).get("game", {}) if live else {}
    players = [p for p in (host or {}).get("players", []) if not p.get("host")] if live else []
    real, in_dolls = player_kinds(players)
    # (v141 beta 7) the game now unranked (1: its statistics with a VS rating of 0, a doll was in it or HOST_UNRANKED always), 0
    # ranked, None not known (an older game, or not online)
    unranked = (host or {}).get("unranked") if live else None
    return {"bot": n, "account": read_kv(bot_env(n)).get("HOST_ACCOUNT_ID", ""), "port": port_of(n), "service": svc,
            "enabled": enabled, "online": online, "reason": reason, "name": game.get("name", ""),
            "players": len(players), "real": real, "dolls": in_dolls, "max": game.get("max", 0), "unranked": unranked}


def cmd_bots():
    return {"ok": True, "bots": [bot_summary(n) for n in bots()], "max": MAX_BOTS, "sys": sys_now()}


def status(prev=None, slow=None):
    """The bot's whole state; prev: the last call's process sample (watch computes CPU from it)."""
    svc, enabled = service_state()
    host, age = read_status()
    proc = host_process()
    now = time.monotonic()
    cpu = None
    if proc and prev and prev.get("pid") == proc["pid"]:
        dt = now - prev["t"]
        if dt > 0:
            cpu = round(100.0 * (proc["ticks"] - prev["ticks"]) / os.sysconf("SC_CLK_TCK") / dt, 1)
    sample = dict(proc, t=now) if proc else None
    online, reason = online_of(svc, host, age, proc)
    kv = read_kv(bot_env())
    res = {"ok": True, "agent": AGENT_VERSION, "bot": BOT, "time": int(time.time()),
           "installed": os.path.isfile(os.path.join(HOME_DIR, "mgo1host.exe")),
           "service": svc, "enabled": enabled, "online": online, "reason": reason, "status_age": None if age is None else round(age, 1),
           "lobby_restart_in": lobby_restart_in(svc, host, age, proc),
           "host": host, "account": kv.get("HOST_ACCOUNT_ID", ""), "port": port_of(), "lists": lists_json(*lists_read()),
           "proc": {"cpu": cpu, "rss_mb": proc["rss"] // 2**20 if proc else None,
                    "uptime_s": int(uptime_s() - proc["start"] / os.sysconf("SC_CLK_TCK")) if proc else None}}
    res.update(slow if slow is not None else {"sys": sys_now(), "schedule": schedule_now(), "bots": [bot_summary(n) for n in bots()]})
    return res, sample


# ---- the firewall -----------------------------------------------------------------------------------
def firewall_kind():
    rc, so, _ = sh([tool("ufw"), "status"], 15) if shutil.which("ufw") or os.environ.get("MGO1_UFW") else (1, "", "")
    if rc == 0 and "Status: active" in so:
        return "ufw"
    if shutil.which("firewall-cmd") or os.environ.get("MGO1_FIREWALL-CMD"):
        rc, so, _ = sh([tool("firewall-cmd"), "--state"], 15)
        if rc == 0 and "running" in so:
            return "firewalld"
    return "none"


def firewall(port, open_it=True):
    """The server's own firewall for a bot's UDP port: (kind, done)."""
    kind = firewall_kind()
    if kind == "ufw":
        rc, _, _ = sh([tool("ufw")] + (["allow"] if open_it else ["delete", "allow"]) + ["%d/udp" % port], 30)
        return kind, rc == 0
    if kind == "firewalld":
        rc, _, _ = sh([tool("firewall-cmd"), "-q", "--permanent", ("--add-port=%d/udp" if open_it else "--remove-port=%d/udp") % port], 30)
        if rc == 0:
            rc, _, _ = sh([tool("firewall-cmd"), "-q", "--reload"], 30)
        return kind, rc == 0
    return kind, True


def cmd_firewall():
    return {"ok": True, "firewall": firewall_kind(), "ports": [port_of(n) for n in bots()]}


# ---- bots: add, remove, their port ------------------------------------------------------------------
def cmd_bot_add(args):
    have = bots()
    if len(have) >= MAX_BOTS:
        raise Fail("this server already has %d bots" % MAX_BOTS, "bots_full", MAX_BOTS)
    n = next(i for i in range(1, MAX_BOTS + 1) if i not in have)
    used = {port_of(b) for b in have}
    if args:
        if not args[0].isdigit() or int(args[0]) not in PORTS:
            raise Fail("port: 5730 to 5739", "port_range")
        port = int(args[0])
        if port in used:
            raise Fail("UDP port %d is already bot %d's" % (port, next(b for b in have if port_of(b) == port)), "port_used", port, next(b for b in have if port_of(b) == port))
    else:
        free = [p for p in PORTS if p not in used]
        if not free:
            raise Fail("no free UDP port (5730 to 5739)", "no_port")
        port = 5729 + n if 5729 + n in free else free[0]
    try:
        with open(os.path.join(HOME_DIR, "bot.env.example")) as f:
            text = f.read()
    except OSError:
        text = "HOST_ACCOUNT_ID=\nHOST_ACCOUNT_PASSWORD=\nUDP_PORT=5730\n"
    text = re.sub(r"(?m)^UDP_PORT=.*$", "UDP_PORT=%d" % port, text)
    write_atomic(bot_env(n), text, 0o600)
    if not os.path.isfile(bot_game(n)):
        src = os.path.join(HOME_DIR, "game.ini.example")
        shutil.copyfile(src, bot_game(n)) if os.path.isfile(src) else write_atomic(bot_game(n), "")
        os.chmod(bot_game(n), 0o644)
    if not os.path.isfile(bot_white(n)):
        write_atomic(bot_white(n), "# MGO1 dedicated host: the whitelist of bot %d\n# only = on: only these names may play "
                     "(the others are kicked as soon as they join)\nonly = off\n" % n)
    for d in (bot_state(n), os.path.join(bot_state(n), "events")):
        os.makedirs(d, exist_ok=True)
        chown_bot(d)
    kind, done = firewall(port, True)
    global BOT
    BOT = n
    note("admin", do="bot-add", port=port)
    return {"ok": True, "bot": n, "port": port, "firewall": kind, "firewall_done": done}


def cmd_bot_remove(args):
    if not args or not args[0].isdigit() or int(args[0]) not in bots():
        raise Fail("bot-remove <bot>", "usage", "bot-remove <bot>")
    n = int(args[0])
    port = port_of(n)
    systemctl("disable", "--now", service(n), timeout=60)
    for p in (bot_env(n), bot_game(n), bot_white(n), os.path.join(CONF, "bot%d.vdolls" % n)):
        try:
            os.remove(p)
        except OSError:
            pass
    shutil.rmtree(bot_state(n), ignore_errors=True)
    kind, done = firewall(port, False)
    return {"ok": True, "bot": n, "port": port, "firewall": kind, "firewall_done": done}


def cmd_bot_port(args):
    need_bot()
    if not args or not args[0].isdigit() or int(args[0]) not in PORTS:
        raise Fail("bot-port <5730 to 5739>", "usage", "bot-port <5730 to 5739>")
    port, old = int(args[0]), port_of()
    for b in bots():
        if b != BOT and port_of(b) == port:
            raise Fail("UDP port %d is already bot %d's" % (port, b), "port_used", port, b)
    set_env_keys({"UDP_PORT": str(port)})
    if old != port:
        firewall(old, False)
    kind, done = firewall(port, True)
    note("admin", do="port", port=port)
    res = {"ok": True, "port": port, "firewall": kind, "firewall_done": done}
    if service_state()[0] == "active":
        res["restart"] = cmd_restart(noted=False)
    return res


def set_env_keys(values, path=None, mode=0o600):
    """Some keys of an env file changed or added (the bot's by default), its other lines kept."""
    path = path or bot_env()
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:                               # (v150-host beta 16: a file that is there and cannot be read is
        lines = []                                          # never written anew with these keys alone: the call ends on its error)
    done, new = set(), []
    for line in lines:
        k = line.split("=", 1)[0].strip() if "=" in line and not line.lstrip().startswith("#") else None
        if k in values:
            new.append("%s=%s" % (k, values[k]))
            done.add(k)
        else:
            new.append(line)
    new += ["%s=%s" % (k, v) for k, v in values.items() if k not in done]
    write_atomic(path, "\n".join(new) + "\n", mode)


