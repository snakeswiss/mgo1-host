                       r"|Deactivated successfully|Failed with result|ps2 f\d+: (text: |host watch: |host settings|lists: |blacklist: "
                       r"|whitelist: |kick P|command )|: step \d+: \"|RESULT ")
ESSENTIAL_MESSAGE = (r"^mgo1host: |HOST_ACCOUNT_\w+ is not set|^(Started|Stopped|Stopping) |Main process exited|Scheduled restart job"
                     r"|Deactivated successfully|Failed with result|^ps2 f\d+: (text: |host watch: |host settings|lists: |blacklist: "
                     r"|whitelist: |kick P|command )|^step \d+: \"|^RESULT ")


def cmd_log(args):
    """log [lines] [--essential]: the last lines of the bot's journal, the log-in data masked."""
    need_bot()
    n = int(args[0]) if args and args[0].isdigit() else 200
    essential = "--essential" in args
    base = [tool("journalctl"), "-u", service(), "--no-pager", "-o", "short-iso"]
    rc, so, se = 1, "", ""
    if essential:                                    # the whole journal, filtered by journalctl itself
        # ((v141 beta 4) the last 7 days: the whole journal was read back every 5 s when such lines were few)
        rc, so, se = sh(base + ["-n", str(min(n, 2000)), "--since", "-7d", "--grep", ESSENTIAL_MESSAGE], 60)
        if rc == 1 and not se.strip():
            rc = 0                                   # no line matches: journalctl says so with 1
    if not essential or rc:                          # or the last lines, filtered here (a journalctl without --grep)
        rc, so, se = sh(base + ["-n", str(40000 if essential else min(n, 2000))], 60)
    if rc and not so:
        raise Fail("journalctl: " + se.strip(), "journal", se.strip().replace("|", " "))
    lines = so.splitlines()
    if essential:
        lines = [x for x in lines if ESSENTIAL.search(x)]
    sec = secrets()
    return {"ok": True, "lines": [redact(x, sec) for x in lines[-min(n, 2000):]]}


# ---- the daily logs (host/mgo1log): a folder per bot, doll and the doll manager, a file per day (UTC) ----
LOG_SOURCE_RE = re.compile(r"^(bot([1-9]|10)|doll([1-9]|[1-5][0-9]|6[0-4])|manager)$")
DAY_RE = re.compile(r"^\d{4}-\d\d-\d\d$")


def log_sort_key(name):
    m = re.match(r"^(bot|doll)(\d+)$", name)
    return (0 if name.startswith("bot") else 1 if name.startswith("doll") else 2, int(m.group(2)) if m else 0)


def cmd_logs(args):
    """logs [list]: the sources and their days; logs get <source> <day> [...]: that day's lines."""
    if not args or args[0] == "list":
        out_ = []
        try:
            names = sorted((n for n in os.listdir(LOG_ROOT) if LOG_SOURCE_RE.match(n)), key=log_sort_key)
        except OSError:
            names = []
        limit = time.strftime("%Y-%m-%d", time.gmtime(time.time() - 31 * 86400))
        for n in names:
            days = []
            for p in sorted(glob.glob(os.path.join(LOG_ROOT, n, "*.log")), reverse=True):
                day = os.path.basename(p)[:10]
                if not DAY_RE.match(day):
                    continue
                if day < limit:                       # (mgo1log removes them; an idle source keeps them until then)
                    for q in (p, p[:-4] + ".sum"):
                        try:
                            os.remove(q)
                        except OSError:
                            pass
                    continue
                info = {"day": day, "size": 0}
                try:
                    info["size"] = os.path.getsize(p)
                except OSError:
                    pass
                try:
                    with open(p[:-4] + ".sum", encoding="utf-8") as f:
                        sm = json.load(f)
                    if isinstance(sm, dict):
                        for k in ("lines", "E", "W", "starts", "crashes", "first", "last"):
                            if k in sm:
                                info[k] = sm[k]
                except (OSError, ValueError):
                    pass
                days.append(info)
            if days:
                out_.append({"source": n, "days": days})
        return {"ok": True, "logs": out_, "now": int(time.time() * 1000)}
    if args[0] != "get" or len(args) < 3:
        raise Fail("logs [list] | logs get <source> <day>", "usage", "logs get <bot1|doll1|manager> <YYYY-MM-DD>")
    src, day = args[1], args[2]
    if not LOG_SOURCE_RE.match(src) or not DAY_RE.match(day):
        raise Fail("logs get <bot1..10|doll1..64|manager> <YYYY-MM-DD>", "usage", "logs get <bot1|doll1|manager> <YYYY-MM-DD>")
    opt = {}
    i = 3
    while i < len(args):
        if args[i] in ("--level", "--from", "--lines", "--find", "--tail") and i + 1 < len(args):
            opt[args[i]] = args[i + 1]
            i += 2
        else:
            i += 1
    level = opt.get("--level", "")
    first = int(opt["--from"]) if opt.get("--from", "").isdigit() else 0
    most = max(1, min(int(opt["--lines"]) if opt.get("--lines", "").isdigit() else 2000, 5000))
    find = opt.get("--find", "").upper()
    path = os.path.join(LOG_ROOT, src, day + ".log")
    if not os.path.isfile(path):
        raise Fail("no log of %s on %s" % (src, day), "no_log", src, day)
    sec = secrets()
    # (2.6) --tail N: the day's last N lines (the newest: what went wrong just now), "from" their first one's number
    tail = max(1, min(int(opt["--tail"]), 5000)) if opt.get("--tail", "").isdigit() else 0
    lines, n, total = [], 0, 0
    last = collections.deque(maxlen=tail) if tail else None
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.rstrip("\n")
            parts = line.split(" ", 2)
            lv = parts[1] if len(parts) > 2 and parts[1] in ("E", "W", "I") else "I"
            if level and lv not in level:
                continue
            if find and find not in line.upper():
                continue
            total += 1
            if last is not None:
                last.append(line)
            elif n >= first and len(lines) < most:
                lines.append(redact(line, sec))
            n += 1
    if last is not None:
        first = total - len(last)
        lines = [redact(x, sec) for x in last]
    return {"ok": True, "source": src, "day": day, "lines": lines, "from": first, "total": total,
            "next": first + len(lines) if first + len(lines) < total else -1}


# ---- (v150-host beta 16) a day's view when the file is too long for an export; the crash reports -------------------------
LOG_VIEW_LINES = int(os.environ.get("MGO1_LOG_VIEW_LINES", "100000"))   # the lines of a day's view (MGO1 Host's SAVE takes the last 100000)
LOG_VIEW_BURST = 200                                         # a shape's lines shown in 10 s of the log's own clock (mgo1log's MGO1_LOG_BURST)
# a number as mgo1log's flood guard takes it (host/mgo1log NUMBER, NUMBER_BYTES): a line's shape is its text less its numbers
LOG_NUMBER = re.compile(r"\b(?:0x)?[0-9a-fA-F]*[0-9][0-9a-fA-F]*\b|\b[a-fA-F]{8,}\b")
LOG_NUMBER_BYTES = b"0123456789abcdefABCDEFxX"
CRASH_NAME_RE = re.compile(r"^(\d{4})-(\d\d)-(\d\d)_(\d\d)(\d\d)(\d\d)_([a-z0-9]{1,16})(?:_\d)?\.txt$")


def log_view(path, level, find):
    """A day's file as it is shown when it holds more lines than a view takes: (offsets, notes, flood, lines). offsets: the
    file's place of each line shown, or -(k + 1) for notes[k], a line of the agent's own that stands for a flood's lines
    (as mgo1log's guard writes them since beta 16; a file written before has them line by line): of each shape, 200 lines
    at most in 10 s of the log's clock are shown, none while the shape goes on from the 10 s before, and the rest counted
    with the first and the last one's own numbers. flood: the lines so left out; lines: those that pass the filters."""
    import array
    offsets, notes = array.array("q"), []
    flood = lines = off = 0
    bucket, seen, shapes, order, carried, last_stamp = None, {}, {}, [], {}, b""

    def close():
        """The 10 s end: a note for each shape with lines left out; those shapes go on into the next 10 s."""
        nonlocal seen, shapes, order, carried
        nxt, keys = {}, {}
        for sh in order:
            r = shapes[sh]
            if r[1]:
                notes.append("%s W mgo1host-agent: %d more lines like \"%s\", the first at %s%s, the last at %s%s (not shown one by one)" % (
                    last_stamp.decode("ascii", "replace"), r[1], sh if len(sh) <= 200 else sh[:197] + "...", r[2][11:23], r[3], r[4][11:23], r[5]))
                offsets.append(-len(notes))
                nxt[sh] = True
                keys[r[6]] = True
        seen, shapes, order, carried = keys, {}, [], nxt

    def numbers(text):
        v = " ".join(LOG_NUMBER.findall(text)[:8])
        return " (%s)" % v[:120] if v else ""

    with open(path, "rb") as f:
        for raw in f:
            here, off = off, off + len(raw)
            parts = raw.split(b" ", 2)
            lv = parts[1] if len(parts) > 2 and parts[1] in (b"E", b"W", b"I") else b"I"
            if level and lv.decode() not in level:
                continue
            if find and find not in raw.decode("utf-8", "replace").upper():
                continue
            lines += 1
            if raw[:18] != bucket:                           # the log's own clock: 10 s by 10 s
                if bucket is not None:
                    close()
                bucket = raw[:18]
            last_stamp = raw[:24]
            body = parts[2] if len(parts) > 2 else raw
            key = body.translate(None, LOG_NUMBER_BYTES)
            n = seen.get(key, 0)
            if n is not True:
                if n < LOG_VIEW_BURST or lv == b"E":
                    seen[key] = n + 1
                    offsets.append(here)
                    continue
                seen[key] = True                             # lines alike less their numbers past a burst: their shapes counted
            text = body.decode("utf-8", "replace").rstrip("\r\n")
            sh = LOG_NUMBER.sub("<n>", text)
            r = shapes.get(sh)
            if r is None:
                r = shapes[sh] = [LOG_VIEW_BURST if sh in carried or lv == b"E" else 0, 0, "", "", "", "", key]
                order.append(sh)
            if lv == b"E" or (r[0] < LOG_VIEW_BURST and sh not in carried):
                r[0] += 1
                offsets.append(here)
                continue
            stamp = raw[:24].decode("ascii", "replace")
            if not r[1]:
                r[2], r[3] = stamp, numbers(text)
            r[1] += 1
            r[4], r[5] = stamp, numbers(text)
            flood += 1
    if bucket is not None:
        close()
    return offsets, notes, flood, lines


def cmd_logs_view(args):
    """(v150-host beta 16) logs, with a day's view that an export can hold. MGO1 Host's SAVE takes the last 100000 lines of
    `logs get`'s view (5000 a call from total - 100000): of a day flooded before the flood guard (9 and 10 November 2026:
    640000 lines a wild address each) it held the flood alone. A day's file of more than LOG_VIEW_LINES lines is shown less
    its floods' lines (log_view), then less its oldest lines by whole blocks (a view that grows keeps its numbers), and the
    view's first line says how many lines the day holds and how many are left out. --raw, a shorter file, the list: cmd_logs
    as it was."""
    if len(args) < 3 or args[0] != "get" or "--raw" in args:
        return cmd_logs([a for a in args if a != "--raw"])
    src, day = args[1], args[2]
    path = os.path.join(LOG_ROOT, src, day + ".log")
    if not LOG_SOURCE_RE.match(src) or not DAY_RE.match(day) or not os.path.isfile(path):
        return cmd_logs(args)                                # (its errors)
    file_lines = 0
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            file_lines += block.count(b"\n")
    if file_lines <= LOG_VIEW_LINES:
        return cmd_logs(args)
    opt, i = {}, 3
    while i < len(args):
        if args[i] in ("--level", "--from", "--lines", "--find", "--tail") and i + 1 < len(args):
            opt[args[i]] = args[i + 1]
            i += 2
        else:
            i += 1
    first = int(opt["--from"]) if opt.get("--from", "").isdigit() else 0
    most = max(1, min(int(opt["--lines"]) if opt.get("--lines", "").isdigit() else 2000, 5000))
    tail = max(1, min(int(opt["--tail"]), 5000)) if opt.get("--tail", "").isdigit() else 0
    offsets, notes, flood, lines = log_view(path, opt.get("--level", ""), opt.get("--find", "").upper())
    block = max(1, LOG_VIEW_LINES // 10)
    room = LOG_VIEW_LINES - 1                                # (the first line is the agent's own)
    cut = 0 if len(offsets) <= room else -(-(len(offsets) - room) // block) * block
    head = []
    if flood or cut:
        left = []
        if flood:
            left.append("%d of them, the lines of floods (summarised below: \"more lines like\")" % flood)
        if cut:
            left.append("its %d oldest lines (it shows %d at most)" % (cut, LOG_VIEW_LINES))
        head = ["mgo1host-agent: this day's file holds %d lines: this view leaves out %s; logs get ... --raw: the file as it is" % (lines, " and ".join(left))]
    total = len(head) + len(offsets) - cut
    if tail:
        first = max(0, total - tail)
        most = tail
    sec = secrets()
    out_ = []
    with open(path, "rb") as f:
        for n in range(first, min(total, first + most)):
            k = n - len(head)
            if k < 0:                                        # the agent's line, at the time of the first line shown
                o = offsets[cut] if cut < len(offsets) else -1
                stamp = notes[-o - 1][:24] if o < 0 else ""
                if o >= 0:
                    f.seek(o)
                    stamp = f.read(24).decode("ascii", "replace")
                out_.append("%s W %s" % (stamp if re.match(r"^\d{4}-\d\d-\d\dT", stamp) else day + "T00:00:00.000Z", head[0]))
                continue
            o = offsets[cut + k]
            if o < 0:
                out_.append(redact(notes[-o - 1], sec))
            else:
                f.seek(o)
                out_.append(redact(f.readline().decode("utf-8", "replace").rstrip("\n"), sec))
    return {"ok": True, "source": src, "day": day, "lines": out_, "from": first, "total": total,
            "next": first + len(out_) if first + len(out_) < total else -1, "file_lines": lines, "flood": flood, "cut": cut}


def crash_sources(args):
    """The log folders asked for: -b <bot>, --doll <n> (or --bot <bot> before the command), else every bot's and doll's."""
    for flag, kind, most in (("-b", "bot", MAX_BOTS), ("--doll", "doll", 64)):
        if flag in args:
            i = args.index(flag)
            if i + 1 >= len(args) or not args[i + 1].isdigit() or not 1 <= int(args[i + 1]) <= most:
                raise Fail("crashes [-b <bot> | --doll <n>]", "usage", "crashes [-b <bot> | --doll <n>]")
            return ["%s%d" % (kind, int(args[i + 1]))]
    if "--bot" in sys.argv:
        return ["bot%d" % BOT]
    try:
        return sorted((n for n in os.listdir(LOG_ROOT) if LOG_SOURCE_RE.match(n) and n != "manager"), key=log_sort_key)
    except OSError:
        return []


def crash_head(path, sec):
    """A report's header (host/mgo1log crash_report: "key: value" lines before "----"): its fields, the players' lines apart,
    the round's rule and map by their names."""
    head, players = {}, []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for n, line in enumerate(f):
                line = line.rstrip("\n")
                if line == "----" or n > 200:
                    break
                k, sep, v = line.partition(": ")
                if not sep or not re.match(r"^[a-z_]{1,16}$", k):
                    continue
                if k in ("player", "vdoll"):                 # (a line each: "who")
                    players.append(redact(v if k == "player" else "virtual doll " + v, sec))
                else:
                    head[k] = redact(v, sec)
    except OSError:
        return {}, []
    m = re.search(r"\(rule (\d+), map (\d+)\)", head.get("round", ""))
    if m:
        head["rule"], head["map"] = int(m.group(1)), int(m.group(2))
        head["rule_name"] = next((r["name"] for r in RULES if r["id"] == head["rule"]), "")
        head["map_name"] = next((x["name"] for x in MAPS if x["id"] == head["map"]), "")
    return head, players


def crash_item(src, name, sec):
    path = os.path.join(LOG_ROOT, src, "crash", name)
    m = CRASH_NAME_RE.match(name)
    head, players = crash_head(path, sec)
    item = {"source": src, "name": name, "reason": m.group(7), "time": "%s-%s-%sT%s:%s:%sZ" % m.groups()[:6], "size": 0}
    try:
        item["size"] = os.path.getsize(path)
    except OSError:
        pass
    item.update({k: v for k, v in head.items() if k not in ("source", "reason")})
    item["who"] = players
    return item


def cmd_crashes(args):
    """crashes [-b <bot> | --doll <n>]: the crash reports (docs/CRASH_REPORTS.md), the newest first: each one's source, file,
    time (UTC), reason (crash70, signal<N>, hung, lost, exit<N>), size and its header's fields (what, when, version, state,
    game, round with the rule's and the map's names, players, who: the players' lines, pace, wild: the first access outside
    the memory, lines)."""
    sec = secrets()
    out_ = []
    for src in crash_sources(args):
        try:
            names = [n for n in os.listdir(os.path.join(LOG_ROOT, src, "crash")) if CRASH_NAME_RE.match(n)]
        except OSError:
            continue
        out_ += [crash_item(src, n, sec) for n in names]
    out_.sort(key=lambda x: (x["name"][:17], x["source"]), reverse=True)
    return {"ok": True, "crashes": out_[:400], "now": int(time.time() * 1000)}


def cmd_crash(args):
    """crash [<source>/]<name> [--from <n>] [--lines <n>] [--tail <n>]: one crash report, its header's fields and its lines
    (the header's, "----", then the game's last lines), 2000 a call (5000 at most) as logs get; the log-in data masked."""
    usage = "crash [<bot1|doll1>/]<name> [--from <n>] [--lines <n>] [--tail <n>]"
    if not args or args[0].startswith("-"):
        raise Fail(usage, "usage", usage)
    src, _, name = args[0].rpartition("/")
    if not CRASH_NAME_RE.match(name) or (src and (not LOG_SOURCE_RE.match(src) or src == "manager")):
        raise Fail(usage, "usage", usage)
    found = [x for x in ([src] if src else crash_sources(args[1:])) if os.path.isfile(os.path.join(LOG_ROOT, x, "crash", name))]
    if not found:
        raise Fail("no crash report %s" % args[0], "no_crash", args[0])
    src = found[0]
    opt, i = {}, 1
    while i < len(args):
        if args[i] in ("--from", "--lines", "--tail") and i + 1 < len(args):
            opt[args[i]] = args[i + 1]
            i += 2
        else:
            i += 1
    first = int(opt["--from"]) if opt.get("--from", "").isdigit() else 0
    most = max(1, min(int(opt["--lines"]) if opt.get("--lines", "").isdigit() else 2000, 5000))
    tail = max(1, min(int(opt["--tail"]), 5000)) if opt.get("--tail", "").isdigit() else 0
    sec = secrets()
    item = crash_item(src, name, sec)
    with open(os.path.join(LOG_ROOT, src, "crash", name), encoding="utf-8", errors="replace") as f:
        lines = f.read(4 << 20).split("\n")                  # (a report is 2 MB at most)
    if lines and not lines[-1]:
        lines.pop()
    if tail:
        first = max(0, len(lines) - tail)
        most = tail
    page = [redact(x, sec) for x in lines[first:first + most]]
    item.update({"ok": True, "lines": page, "from": first, "total": len(lines), "next": first + len(page) if first + len(page) < len(lines) else -1})
    return item


def cmd_schedule_set(args):
    if not args or not re.fullmatch(r"off|([01]\d|2[0-3]):[0-5]\d", args[0]):
        raise Fail("schedule-set <HH:MM|off>", "usage", "schedule-set <HH:MM / off>")
    timer = os.path.join(TIMER_DIR, "mgo1host-restart.timer")
