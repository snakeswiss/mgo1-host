def cmd_settings_set(args):
    need_bot()
    try:
        d = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        raise Fail("settings: a JSON object on stdin", "json")
    if not isinstance(d, dict):
        raise Fail("settings: a JSON object on stdin", "json")
    clean = settings_check(d)
    # (v150-host beta 22, sync) a rotation entry on a map this server does not have (a PC map 13 .. with no map.ini in its maps
    # folder) is refused: beta 21 saved it, the launcher left it out and, with none left, the game kept its account's last
    # rotation from SaveMGO's lobby (the earlier settings)
    here = maps_here()
    for pr in [x.strip() for x in clean.get("rotation", "").split(",") if x.strip()]:
        if int(pr.split(":")[1]) not in here:
            text = "rotation: map %s is not on this server (no map.ini for it in %s): %s" % (pr.split(":")[1], maps_dir(), pr)
            raise Fail(text, "rotation_map_missing", pr)
    # (beta 22, sync) --base <version>: the version of the copy the form was filled from; the file changed since (another
    # MGO1 Host, the shell): refused, nothing written (MGO1 Host asks whether to replace it)
    if "--base" in args:
        i = args.index("--base")
        base = args[i + 1] if i + 1 < len(args) else ""
        if base != settings_version(game_text()):
            raise Fail("the bot's settings were changed on the server since they were read: read them again, or save without --base",
                       "settings_changed")
    order = list(SETTING_KEYS)
    lines = ["# MGO1 dedicated host: the game's settings of bot %d (written by MGO1 Host)" % BOT]
    lines += ["%s = %s" % (k, clean[k]) for k in order if k in clean]
    write_atomic(bot_game(), "\n".join(lines) + "\n", 0o644)
    # (v150-host beta 16) fewer seats than its virtual dolls ask for (max_players lowered after vdoll-set, which alone
    # checked the count): VDOLL_COUNT follows, as vdoll-set would refuse it now (the players less the host's entry and
    # the seat kept for a real player). Without this the count shown never plays and the manager warns of it for ever
    lowered = None
    most = min(VDOLL_MAX, max(0, game_max_players(BOT) - 2))
    if vdoll_count_of(read_kv(bot_env()).get("VDOLL_COUNT")) > most:
        set_env_keys({"VDOLL_COUNT": str(most)})
        lowered = most
    more = {} if lowered is None else {"vdoll_count_lowered": lowered}
    note("admin", do="settings", restart="--restart" in args, **more)
    res = dict({"ok": True, "settings": clean}, **more)
    # (beta 22, sync) the saved copy's new version, what the running game plays, and when the save takes effect: "now" (a new
    # game asked), "next game" (a game runs and keeps what it started with: --restart or the restart command to play them at
    # once), "next start" (no game runs)
    res.update(settings_sync(game_text()))
    if "--restart" in args:
        res["restart"] = cmd_restart(noted=False)
        res["takes_effect"], res["pending"], res["left_out"] = "now", [], []
    else:
        res["takes_effect"] = "next game" if res["running"] else "next start"
    return res


