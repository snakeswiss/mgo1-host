    (from --since <ms>, else from now)."""
    need_bot()
    every = float(args[0]) if args and re.fullmatch(r"[\d.]+", args[0]) else 1.0
    every = min(max(every, 0.5), 10.0)
    tail = EventTail()                             # from now on; --since: the ones written since then first
    first = events_read(int(args[args.index("--since") + 1]), 2000)[0] if "--since" in args else []
    end = time.time() + 12 * 3600                 # at most 12 h: the program opens a new one
    prev, slow, slow_at, bots_at, bots_now = None, None, 0.0, 0.0, []
    while time.time() < end:
        if time.time() - slow_at > 10:
            slow_at = time.time()
            events_prune()
            slow = {"sys": sys_now(), "schedule": schedule_now()}
        if time.time() - bots_at > 2:
            bots_at, bots_now = time.time(), [bot_summary(n) for n in bots()]
        res, prev = status(prev, dict(slow, bots=bots_now))
        res["events"] = first + tail.read()
        first = []
        out(res)
        time.sleep(every)
    return None


# ---- the PLAYABLE DOLLs (docs/PLAYABLE_DOLL.md) --------------------------------------------------
MAX_DOLLS = 64
# a doll's settings file, its keys in this order ((v141 beta 5) DOLL_NAME: an accountless doll's name in the game; (v141
# beta 6) DOLL_ADAPT_MIN, DOLL_ADAPT_MAX: the live level's bounds)
DOLL_KEYS = ("DOLL_ACCOUNT_ID", "DOLL_ACCOUNT_PASSWORD", "DOLL_NAME", "DOLL_BOT", "DOLL_DIFFICULTY", "DOLL_ADAPT",
             "DOLL_ADAPT_MIN", "DOLL_ADAPT_MAX", "DOLL_TEAM", "DOLL_ENABLED", "DOLL_LOADOUT", "DOLL_ORDER", "DOLL_AIM")
# (v141 beta 6) the difficulty ladder, 1 to 10 (MGO1Loader/doll_brain.cpp kTierNames; 6 ELITE: beta 5's NIGHTMARE)
DOLL_TIERS = ("TRAINING", "EASY", "NORMAL", "HARD", "EXPERT", "ELITE", "VETERAN", "MASTER", "EXTREME", "PRO")
DOLL_LEVELS = tuple(str(i) for i in range(1, len(DOLL_TIERS) + 1))     # the values taken: "1" to "10"
DOLL_TEAMS = ("auto", "red", "blue", "spectator")
DOLL_LOADOUTS = ("auto", "scorpion", "xm16", "ak47", "m37", "svd", "mosin")
DOLL_ORDERS = ("free", "objective", "target", "hide", "defend", "follow")
DOLL_AIMS = ("pad", "direct")   # (v150-host beta 18) DOLL_AIM: pad (the default, as before) or direct


def doll_aim_of(kv):
    """(v150-host beta 18) A doll's aim as mgo1doll.sh takes it: direct, else pad."""
    return "direct" if str(kv.get("DOLL_AIM", "")).strip().lower() == "direct" else "pad"


def doll_aim_arg(v):
    """(v150-host beta 18) doll-set's "aim": direct or pad (null or "": pad), else refused."""
    a = "pad" if v in (None, "") else v.strip().lower() if isinstance(v, str) else v
    if a not in DOLL_AIMS:
        raise Fail("aim: direct or pad", "doll_aim", json.dumps(v) if not isinstance(v, str) else v)
    return a


def doll_env(n):
    return os.path.join(CONF, "doll%d.env" % n)


def doll_state(n):
    return os.path.join(STATE_ROOT, "doll%d" % n)


def dolls():
    """The dolls this server has: their numbers, in order."""
    res = []
    for p in glob.glob(os.path.join(CONF, "doll*.env")):
        m = re.fullmatch(r"doll(\d+)\.env", os.path.basename(p))
        if m and 1 <= int(m.group(1)) <= MAX_DOLLS:
            res.append(int(m.group(1)))
    return sorted(res)


def doll_number(args, pos=0):
    if len(args) <= pos or not args[pos].isdigit() or not 1 <= int(args[pos]) <= MAX_DOLLS:
        raise Fail("a doll: 1 to %d" % MAX_DOLLS, "usage", "doll 1 to %d" % MAX_DOLLS)
    return int(args[pos])


def doll_level(v, default):
    """(v141 beta 6) A level of a doll's settings file (1 to 10), else the default (as mgo1doll.sh takes it)."""
    return int(v) if v in DOLL_LEVELS else default


def doll_bounds(kv):
    """(v141 beta 6) The live level's bounds of a doll's settings: (DOLL_ADAPT_MIN, DOLL_ADAPT_MAX), 1 and 10 by default,
    the lower first."""
    lo, hi = doll_level(kv.get("DOLL_ADAPT_MIN"), 1), doll_level(kv.get("DOLL_ADAPT_MAX"), 10)
    return min(lo, hi), max(lo, hi)


def level_arg(v, key):
    """(v141 beta 6) A level asked for (doll-set's JSON: a number or its text): 1 to 10, else refused."""
    if isinstance(v, int) and not isinstance(v, bool) and 1 <= v <= len(DOLL_TIERS):
        return v
    if isinstance(v, str) and v.strip() in DOLL_LEVELS:
        return int(v)
    raise Fail("%s: 1 to %d" % (key, len(DOLL_TIERS)), "usage", "%s 1-%d" % (key, len(DOLL_TIERS)))


def follow_level(n, kv=None):
    """(v150-host beta 16) The difficulty of a doll that follows its bot's virtual dolls (DOLL_DIFFICULTY=vdoll): (its level,
    the bot's VDOLL_LEVEL as its game takes it). The k-th of the bot's dolls set to play (DOLL_ENABLED=1), in their numbers'
    order, takes the k-th level of the list, the last for the rest; no VDOLL_LEVEL: 5 (mgo1doll-manager's follow_levels, which
    writes it for the doll's start)."""
    kv = kv if kv is not None else read_kv(doll_env(n))
    try:
        b = int(kv.get("DOLL_BOT", "1"))
    except ValueError:
        b = 1
    levels = vdoll_level_of(read_kv(bot_env(b)).get("VDOLL_LEVEL"))
    lv = levels.split(",")
    k = len([x for x in dolls() if x < n and doll_bot(x) == b and read_kv(doll_env(x)).get("DOLL_ENABLED", "1") == "1"])
    return int(lv[min(k, len(lv) - 1)]), levels


def follows(kv):
    return kv.get("DOLL_DIFFICULTY") == "vdoll"


def difficulty_orders(n, kv, was_following=False):
    """The live orders of a doll's difficulty as its settings have it: its number; one that follows its bot's virtual dolls,
    their level and the live level off; one that followed them and no longer does, its own live level again (DOLL_ADAPT)."""
    if follows(kv):
        doll_order(n, "difficulty %d" % follow_level(n, kv)[0])
        doll_order(n, "adapt off")
    else:
        doll_order(n, "difficulty %d" % doll_level(kv.get("DOLL_DIFFICULTY"), 3))
        if was_following:
            doll_order(n, "adapt %s" % ("off" if kv.get("DOLL_ADAPT", "1") == "0" else "on"))


def follow_sync(b):
    """The running dolls of bot b that follow its virtual dolls' level told it again (the bot's VDOLL_LEVEL changed, or a
    doll before them was added, removed, turned on or off: their place in the list)."""
    for n in dolls():
        kv = read_kv(doll_env(n))
        if doll_bot(n) == b and follows(kv):
            code, state, _ = systemctl("is-active", "mgo1doll@%d" % n)
            if (state.strip() or ("active" if code == 0 else "")) in ("active", "activating"):
                difficulty_orders(n, kv)


