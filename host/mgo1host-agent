            n = a.strip().upper()
            if not PLAYER_RE.match(n) or n.startswith("#"):
                raise Fail("a player's name: 1 to 16 letters, digits or signs", "player_name")
            if c == "blacklist-add":
                black = black + [n] if n not in black else black
