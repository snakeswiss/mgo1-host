def settings_parse(text):
    kv = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        kv[k.strip()] = v.strip()
    return kv


def settings_check(d):
    clean = {}
    for k, v in d.items():
        if k not in SETTING_KEYS:
            raise Fail("unknown setting " + k, "setting_unknown", k)
        kind = SETTING_KEYS[k]
        v = str(v).strip()
        if kind[0] == "text":
            if len(v) > kind[2] or (v and len(v) < kind[1]) or (k == "name" and len(v) < kind[1]):
                raise Fail("%s: %d to %d characters" % (k, kind[1], kind[2]), "setting_len", k, kind[1], kind[2])
            if any(ord(ch) < 32 or ord(ch) > 126 for ch in v):
                raise Fail(k + ": plain ASCII characters only (the game's keyboard)", "setting_ascii", k)
            if k == "password" and v and not NAME_RE.match(v):
                raise Fail("password: letters, digits, - _ . only", "setting_pw")
        elif kind[0] == "int":
            if not re.fullmatch(r"\d+", v) or not kind[1] <= int(v) <= kind[2]:
                raise Fail("%s: %d to %d" % (k, kind[1], kind[2]), "setting_range", k, kind[1], kind[2])
        elif kind[0] == "switch":
            if v.lower() not in ("on", "off"):
                raise Fail(k + ": on or off", "setting_onoff", k)
            v = v.lower()
        elif kind[0] == "rotation":
            pairs = [x.strip() for x in v.split(",") if x.strip()]
            if not 1 <= len(pairs) <= 15:
                raise Fail("rotation: 1 to 15 rule:map pairs", "rotation")
            for pr in pairs:
                m = ROTATION_PAIR.fullmatch(pr)
                if not m or (int(m.group(1)), int(m.group(2))) not in ROTATION_PLAYS:
                    raise Fail("rotation: " + ROTATION_TEXT + " (" + pr + ")", "rotation_pair", pr)
            v = ", ".join(pairs)
        clean[k] = v
    # (v141 beta 5) REIKO HINOMOTO/ROWDY REIKO take two unique characters' places: the unique characters on with them (as
    # the game has them then)
    if clean.get("rumble_roses") == "on":
        clean["unique_characters"] = "on"
    return clean


