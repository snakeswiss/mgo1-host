# SaveMGO MGO1 PLAYABLE DOLL: one doll (/etc/mgo1host/doll<N>.env, N = 1 to 64), managed by mgo1doll-manager
# (no comment at the end of a line: systemd would read it as part of the value). MGO1 Host.exe's
# PLAYABLE DOLL page writes this file; by hand, keep it readable by root only (chmod 600). A file edited on Windows
# (lines ending in a carriage return) or with a value in quotes is read the same: both are taken off.

# The SaveMGO account the doll logs in with (an existing account, its own: not a bot's, not a player's).
# Capitals, digits, - _ . (MGO1 accounts are in capitals; small letters are typed as capitals).
# Both empty (the default): an accountless doll, DOLL_<N> (user id 0x7F000000 + N) in its bot's own lobby on
# 127.0.0.1 (mgo1-dollgate, docs/PLAYABLE_DOLL.md 1), unless server.env says DOLL_GATE=0.
DOLL_ACCOUNT_ID=
DOLL_ACCOUNT_PASSWORD=

# an accountless doll's name in the game, as every player sees it (empty: DOLL_<N>): 3 to 15 letters
# A to Z, digits, spaces (not first, not last, never two together) and . _ - ! ? + *; not another doll's name
# (MGO1 Host.exe: NAME IN GAME and RENAME in its ACTIONS; mgo1host-agent doll-set N with {"name": ...})
DOLL_NAME=

# The bot whose game the doll plays in (1 to 10)
DOLL_BOT=1

# its difficulty, 1 to 10: 1 TRAINING, 2 EASY, 3 NORMAL, 4 HARD, 5 EXPERT, 6 ELITE (the former NIGHTMARE),
# 7 VETERAN, 8 MASTER, 9 EXTREME, 10 PRO: its reactions, its aim, its tactics (changed live: mgo1host-agent doll-order N
# difficulty 4); another value: 3. vdoll: the level of its bot's virtual dolls (the bot's VDOLL_LEVEL:
# the k-th of the bot's dolls set to play takes the k-th level of the list, the last for the rest; none set: 5), the live
# level below off whatever DOLL_ADAPT says (mgo1host-agent doll-order N difficulty vdoll, doll-all <bot> difficulty vdoll)
DOLL_DIFFICULTY=3

# 1: the live level (docs/PLAYABLE_DOLL.md): from the difficulty above, it moves over the ladder after the strength of
# its enemies and of its own side, within DOLL_ADAPT_MIN and DOLL_ADAPT_MAX; 0: always the difficulty above
DOLL_ADAPT=1

# the live level's bounds, 1 to 10 (1 and 10 by default; the wrong way round: swapped), changed live:
# mgo1host-agent doll-order N adapt_min 3, doll-order N adapt_max 8
DOLL_ADAPT_MIN=1
DOLL_ADAPT_MAX=10

# auto, red, blue, spectator: the team it takes (auto: the one with fewer players)
DOLL_TEAM=auto

# its weapons: auto (a role by its number: AK-47, SVD, XM16E1, M37), or scorpion, xm16, ak47, m37, svd, mosin,
# with ,m1911 or ,mk22 for the secondary (e.g. svd,mk22)
DOLL_LOADOUT=auto

# what it does: free, objective, hide, defend, follow <player>, target <player>
DOLL_ORDER=free

# how it turns its view: pad (the default, as before: through the stick, as a player does) or direct (at
# the speed of a virtual doll of its level, without the stick); changed live: mgo1host-agent doll-order N aim direct, doll-all <bot> aim pad (MGO1 Host.exe:
# AIM in its ACTIONS, DOLLS' AIM for a bot's dolls); another word: pad (mgo1doll.sh's log says so)
DOLL_AIM=pad

# 1: the doll may play (mgo1doll-manager starts it when its bot's game has a seat for it)
DOLL_ENABLED=1
