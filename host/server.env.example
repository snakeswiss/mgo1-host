# SaveMGO MGO1 dedicated host: the settings of every bot of this server (/etc/mgo1host/server.env)
# (no comment at the end of a line: systemd would read it as part of the value)

# Where the disc's files are (MGS/NET/MGS3_N.ELF, STAGE_N.DAT, SLOT_N.DAT and MODULES/)
DISC_DIR=/opt/mgo1host/disc

# 1: the P2P datagrams in the clear in /var/lib/mgo1host/bot<N>/run/p2p.tsv (tools/host_check.py
# reads it); about 50 MB an hour with 8 players, for troubleshooting only
P2P_LOG=0

# The PLAYABLE DOLLs: 1 keeps one seat of each bot's game free for a real player (the last doll leaves
# when a real player comes into a full game); 0 lets the dolls take every seat
DOLL_KEEP_SEAT=1

# the pace guard: 1 (the default) a bot whose game, or half its dolls with a real player in it, runs under the
# game's pace two minutes in a row (the processors short, the "pace:" lines) has one doll less, then one more once it keeps
# its pace 10 minutes (docs/DEDICATED_HOST.md 12); 0: off
DOLL_PACE_GUARD=1

# the doll manager's watchdog: a bot's game that wrote its status and then nothing for this many seconds
# (15 to 600; 45 by default) is taken for hung and restarted (its crash report kept, docs/CRASH_REPORTS.md), without the
# 180 s wait of a game that never wrote one. Read at each of the manager's rounds; a value out of range: 45, said once
# HANG_FAST_SECONDS=45

# 1: each bot and each doll on one processor of its own, its Wine server with it (the bots from the first
# processor up, the dolls from the last one down); for a VPS whose virtual processors wait for the hosting machine
# (vmstat's "st" column high): a game's threads take turns, and a turn handed over on the same processor never waits for
# another virtual processor to be scheduled. 0 (the default): the system places them. Taken at each game's start
CPU_PIN=0

# The accountless PLAYABLE DOLLs (docs/PLAYABLE_DOLL.md 1): 1 (the default) each bot starts its dolls' lobby on
# 127.0.0.1 (mgo1-dollgate; TCP DOLL_GATE_PORT_BASE + 2 x (bot - 1) and the next one, nothing to open in a
# firewall) and a doll without an account plays as DOLL_<N>; 0: none, every doll needs a SaveMGO account
DOLL_GATE=1
DOLL_GATE_PORT_BASE=5760
# the address the dolls join their bot's game at: empty, the server's default route's (where the game is)
DOLL_GATE_HOST_ADDR=
# how TX-55's game list (and its public API) shows those dolls: host (the default) each doll a player of the
# game under the host bot's own account (TX-55 always takes it); own, each with its own id and no name (only when TX-55's
# database takes a player with no account); off, kept off the lobby. Their statistics never reach TX-55. Listed, one
# seat of each game always stays free for a real player (DOLL_KEEP_SEAT then counts as 1). Taken at each game's start
DOLL_LIST=host

# SaveMGO's rankings and the dolls: auto (the default) once a PLAYABLE DOLL is in the game (with or without an
# account), the statistics of that game are kept out of the rankings and the VS rating to its end: the host sends them with
# a VS rating of 0, which SaveMGO's server keeps for the game's own scores only (as for a game with a password); always:
# every game's; off: none, every game ranked (as before). Taken at each game's start
HOST_UNRANKED=auto

# the seconds a bot's game waits for a new lobby connection once its connection to the lobby is closed
# (5 to 60): still closed then, the game ends with code 6 and its service starts a new one (mgo1host.sh's log says so)
HOST_LOBBY_GRACE=10

# the seconds a bot's game keeps a joiner that is still loading its stage (or waiting for the round)
# past the game's own silence rules, which end a silent player after 25 to 30 s (docs/DEDICATED_HOST.md 21): 0 to 300,
# 0 the game's rules as they are; unset: the game's 60. A bot's bot<N>.env may set its own. Taken at each game's start
# JOINER_HOLD_S=60

# Developer compatibility only, keep 0 (docs/DEDICATED_HOST.md 9): how a Host Only game of 9 (8 players) is
# told to SaveMGO's lobby. 0: as 9, the host list shows 8 seats; a PC needs an MGO1.exe that takes such a game for a game
# of 8 (the list's hint, not its maximum: an old MGO1.exe fails to join it, 1059). 1: as 8 again (the older form: the list
# shows 7 seats, every MGO1.exe joins)
HOST_LIST_9_AS_8=0
# 1: the lobby server takes games of more than 8 players (9 with Host Only): the real maximum is told (else 8, or 9,
# and the game of more told by the list's hint, bit 5)
LOBBY_BIG_GAMES=0
