// MGO1 Host.exe: icon, fonts, SaveMGO logo, manifest, version.
#include <windows.h>
#include "resource.h"
#include "../src/version.h"

IDI_APP ICON "app.ico"
IDR_FONT_REGULAR RCDATA "../fonts/FiraSansCondensed-Regular.ttf"
IDR_FONT_SEMIBOLD RCDATA "../fonts/FiraSansCondensed-SemiBold.ttf"
IDR_FONT_BOLD RCDATA "../fonts/FiraSansCondensed-Bold.ttf"
IDR_FONT_MONO RCDATA "../fonts/FiraMono-Regular.ttf"
IDR_LOGO RCDATA "savemgo.png"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MGO1HOST_VERSION_RC
PRODUCTVERSION MGO1HOST_VERSION_RC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SaveMGO community"
            VALUE "FileDescription", "MGO1 Host: the SaveMGO MGO1 dedicated host's control panel"
            VALUE "FileVersion", MGO1HOST_VERSION
            VALUE "InternalName", "MGO1 Host"
            VALUE "OriginalFilename", "MGO1 Host.exe"
            VALUE "ProductName", "MGO1 Host"
            VALUE "ProductVersion", MGO1HOST_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
